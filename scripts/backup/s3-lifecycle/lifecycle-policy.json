{
  "Rules": [
    {
      "ID": "postgresql-wal-to-ia",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "postgres/"
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        },
        {
          "Days": 90,
          "StorageClass": "GLACIER"
        }
      ],
      "Expiration": {
        "Days": 365
      }
