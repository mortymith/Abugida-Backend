# Normalize line endings for all text files.
* text=auto eol=lf

# Keep CRLF on Windows batch files.
*.bat text eol=crlf

# Binary files must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary