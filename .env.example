# ═══════════════════════════════════════════════════════════════════════════════
# Infrastructure Environment Configuration Template
# Source: deployement.md v3.0.0 §4.1
#
# Copy to .env and fill in values:   cp .env.example .env
#
# Tiered secrets strategy (ADR-006):
#   - Development:        ALL values come from .env.
#                         Sensitive keys MUST be replaced before first boot —
#                         they are only applied when volumes are created
#                         (change them later requires `just dev-clean`).
#   - Staging/Production: Sensitive values are managed by HashiCorp Vault
#                         and injected into the environment at deploy time.
#                         The dev defaults in .env must NEVER be used there.
#
# Legend:
#   REQUIRED        — must be set to a real value before running (no safe default)
#   [secret]        — sensitive; never commit real values anywhere
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment Identity ────────────────────────────────────────────────────
ENVIRONMENT=development
COMPOSE_PROJECT_NAME=infra

# ─── Domain Configuration (ADR-016: Dev *.localhost / Prod yourdomain.com) ───
DOMAIN_API=localhost
DOMAIN_DASHBOARD=localhost
DOMAIN_MARKETING=marketing.localhost
DOMAIN_SYNC=sync.localhost
DOMAIN_SIGNOZ=localhost.localhost
DOMAIN_MINIO_CONSOLE=localhost
CADDY_EMAIL=admin@example.com
# ACME issuer for Caddy in production: letsencrypt | zerossl | local (dev CA)
CADDY_ACME_ISSUER=letsencrypt

# ─── Exposed Ports (development/staging only; prod publishes nothing) ────────
# See spec §12.1 Port Reference for full mapping
API_PORT=3001
DASHBOARD_PORT=8081
MARKETING_PORT=8082
REDIS_PORT=6379
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SIGNOZ_FRONTEND_PORT=3002
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
CLICKHOUSE_HTTP_PORT=8123
VAULT_API_PORT=8200
POWERSYNC_PORT=8085
POWERSYNC_METRICS_PORT=9090
POWERSYNC_SYNC_METRICS_PORT=9091

# ─── Service Replica Counts (production) ─────────────────────────────────────
# Dev/staging always run single instances; these apply to the prod tier only.
API_REPLICAS=1
DASHBOARD_REPLICAS=1
MARKETING_REPLICAS=1

# ─── Resource Limits (per-container, Docker Compose deploy format) ───────────
# Dev defaults below; override files scale up per environment.
API_CPU_LIMIT=1
API_MEM_LIMIT=1g
DASHBOARD_CPU_LIMIT=1
DASHBOARD_MEM_LIMIT=1g
MARKETING_CPU_LIMIT=0.5
MARKETING_MEM_LIMIT=512m
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=512m
SENTINEL_CPU_LIMIT=0.5
SENTINEL_MEM_LIMIT=256m
POSTGRES_CPU_LIMIT=1
POSTGRES_MEM_LIMIT=1g
PGBOUNCER_CPU_LIMIT=0.5
PGBOUNCER_MEM_LIMIT=256m
MINIO_CPU_LIMIT=1
MINIO_MEM_LIMIT=1g
VAULT_CPU_LIMIT=0.5
VAULT_MEM_LIMIT=512m
SIGNOZ_CPU_LIMIT=1
SIGNOZ_MEM_LIMIT=2g
OTEL_CPU_LIMIT=0.5
OTEL_MEM_LIMIT=512m
CLICKHOUSE_CPU_LIMIT=1
CLICKHOUSE_MEM_LIMIT=1g
POWERSYNC_CPU_LIMIT=0.5
POWERSYNC_MEM_LIMIT=512m
CADDY_CPU_LIMIT=2
CADDY_MEM_LIMIT=1g
KEEPALIVED_CPU_LIMIT=0.25
KEEPALIVED_MEM_LIMIT=128m
CLOUDFLARED_CPU_LIMIT=0.5
CLOUDFLARED_MEM_LIMIT=256m

# ─── Observability Retention (ADR-010) ───────────────────────────────────────
SIGNOZ_METRICS_RETENTION_DAYS=7
SIGNOZ_TRACES_RETENTION_DAYS=7
SIGNOZ_LOGS_RETENTION_DAYS=7

# ─── Database Configuration ──────────────────────────────────────────────────
POSTGRES_DB=app
POSTGRES_USER=app
# REQUIRED [secret] — PostgreSQL superuser/app password. Applied only on FIRST
# boot of the postgres volume; rotating later needs `down -v` or manual SQL.
POSTGRES_PASSWORD=change-me
POSTGRES_SHARED_BUFFERS=128MB
# Primary hostname as seen by replicas (prod scaling tier)
POSTGRES_PRIMARY_HOST=postgres-primary
# Composed DATABASE_URL for local dev (apps connect through PgBouncer in Docker)
DATABASE_URL=postgresql://app:change-me@localhost:6432/app
REPLICA1_SLOT_NAME=replica_slot_1
REPLICA2_SLOT_NAME=replica_slot_2

# ─── PgBouncer (connection pooler) ──────────────────────────────────────────
# Extra roles to expose through the pooler (comma-separated). Defaults to
# "app,signoz" (compose-level default). Verifiers are synced from pg_authid
# by the pgbouncer-init job on every stack start; no hashes live in git.
PGBOUNCER_AUTH_USERS=app,signoz
# NOTE: docker/config/pgbouncer/pgbouncer.ini is authoritative at runtime;
# these are consumed by compose and kept in sync with that file.
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MIN_POOL_SIZE=5

# ─── Redis Configuration ────────────────────────────────────────────────────
# Memory ceiling + eviction policy (applied by the container entrypoint;
# unset = whatever redis.conf ships). REQUIRED in practice — the ACL file is
# generated from these at every start, so all four users need passwords.
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_SENTINEL_QUORUM=2
REDIS_TLS_ENABLED=0
REDIS_MIN_REPLICAS=0
REDIS_MIN_REPLICAS_MAX_LAG=10
# REQUIRED [secret] — Redis ACL user passwords (app / admin / readonly / sentinel).
# Applied at every container start by entrypoint.sh (users.acl template).
REDIS_PASSWORD=change-me
REDIS_ADMIN_PASSWORD=change-me
REDIS_READONLY_PASSWORD=change-me
REDIS_SENTINEL_PASSWORD=change-me

# ─── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_BUCKET_NAME=app-data
# REQUIRED [secret] — MinIO root password (min 8 chars). Applied on first boot.
MINIO_ROOT_PASSWORD=change-me

# ─── PowerSync (logical replication + sync streams) ──────────────────────────
# Two least-privilege roles (NOT a shared superuser):
#   - powersync          → logical replication + source reads
#   - powersync_storage  → bucket-storage schema (PowerSync manages it)
# Alphanumeric only — these are embedded in connection URIs by compose.
# REQUIRED [secret] — applied idempotently by `just ps-setup`.
PS_REPLICATION_PASSWORD=change-me
PS_STORAGE_PASSWORD=change-me
# JWKS endpoint validating client sync JWTs — served by Better Auth's jwt
# plugin at <api-base>/api/auth/jwks. Dev default points at the API host;
# staging/prod set the real origin.
PS_JWKS_URI=http://api.localhost/api/auth/jwks
# JVM-style heap hint passed to the Node service roles (overridden per env).
POWERSYNC_NODE_OPTIONS=--max-old-space-size=384

# ─── ClickHouse (observability storage; staging/prod only) ───────────────────
# Single "default" user, password applied by the image entrypoint.
# REQUIRED [secret] in staging/prod — set a strong value (openssl rand hex 32).
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── SigNoz (observability platform; staging/prod only) ──────────────────────
# Metadata store credentials (PostgreSQL via PgBouncer — database "signoz",
# role provisioned by base.yml's signoz-db-setup job) + UI session secret.
# REQUIRED [secret] in staging/prod (openssl rand hex 32 for both).
SIGNOZ_DB_PASSWORD=
SIGNOZ_JWT_SECRET=

# ─── Application Secrets ─────────────────────────────────────────────────────
# REQUIRED [secret] — API signing key for JWT/auth (min 32 chars recommended).
API_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ─── Vault (staging/prod bootstrap) ──────────────────────────────────────────
# 0 = verify Vault TLS (production); 1 = skip verification (local only).
VAULT_SKIP_VERIFY=0

# ─── Cloudflare Tunnel (production only; no-op in dev) ───────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=

# ─── Telegram Alerting (ADR-018) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Backup & S3 (§9) ────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=infrastructure-backups
BACKUP_S3_PREFIX=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30

# ─── Debug / Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=debug
DEBUG_MODE=true

# ─── Deployment (ADR-009) ────────────────────────────────────────────────────
DEPLOY_STRATEGY=recreate
DEPLOY_VERSION=
