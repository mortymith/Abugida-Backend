{
  "name": "@abugida/observability",
  "version": "1.0.0",
  "description": "Shared observability layer for the Abugida backend ecosystem \u2014 Pino logging + OpenTelemetry tracing & metrics over OTLP",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/integrations/hono.d.ts",
      "import": "./dist/integrations/hono.js"
    },
    "./tanstack": {
      "types": "./dist/integrations/tanstack.d.ts",
      "import": "./dist/integrations/tanstack.js"
    },
    "./astro": {
      "types": "./dist/integrations/astro.d.ts",
      "import": "./dist/integrations/astro.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.8.0",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/semantic-conventions": "1.29.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@abugida/eslint-config": "workspace:*",
    "@abugida/prettier-config": "workspace:*",
    "@abugida/typescript-config": "workspace:*",
    "@tanstack/react-start": "1.169.3",
    "@types/bun": "^1.4.4",
    "astro": "^7.4.2",
    "eslint": "^10.13.0",
    "hono": "^4.13.13",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "keywords": [
    "observability",
    "opentelemetry",
    "otel",
    "pino",
    "logging",
    "tracing",
    "metrics",
    "hono",
    "abugida"
  ]
}
