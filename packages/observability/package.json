{
  "name": "@abugida/observability",
  "version": "1.0.0",
  "description": "Shared observability layer for the Abugida backend ecosystem — Pino logging + OpenTelemetry tracing & metrics over OTLP",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/integrations/hono.d.ts",
      "import": "./dist/integrations/hono.js"
    },
    "./tanstack": {
      "types": "./dist/integrations/tanstack.d.ts",
      "import": "./dist/integrations/tanstack.js"
    },
    "./astro": {
      "types": "./dist/integrations/astro.d.ts",
      "import": "./dist/integrations/astro.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "1.30.1",
    "@opentelemetry/core": "1.30.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.57.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-metrics": "1.30.1",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@opentelemetry/semantic-conventions": "1.29.0",
    "pino": "9.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "eslint": "^9.18.0",
    "hono": "^4.7.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  }
}
