{
  "name": "@abugida/auth",
  "version": "0.0.1",
  "description": "Shared authentication layer for Hono and TanStack Start apps, built on better-auth. Ships pluggable Apple ID and Google OAuth providers.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/middleware/hono/index.d.ts",
      "import": "./dist/middleware/hono/index.js"
    },
    "./tanstack": {
      "types": "./dist/middleware/tanstack/index.d.ts",
      "import": "./dist/middleware/tanstack/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\"",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.0.0",
    "@tanstack/react-start": ">=1.0.0",
    "better-auth": "1.6.26",
    "drizzle-orm": ">=0.36.0",
    "hono": ">=4.6.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.87.0",
    "@tanstack/react-start": "^1.87.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@typescript-eslint/parser": "^8.67.0",
    "better-auth": "1.6.26",
    "drizzle-orm": "^0.36.4",
    "eslint": "^10.8.1",
    "hono": "^4.6.14",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
