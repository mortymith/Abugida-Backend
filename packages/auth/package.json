{
  "name": "@abugida/auth",
  "version": "0.0.1",
  "description": "The single source of truth for authentication in the Abugida monorepo. Owns the Better Auth instance, plugin registry (Google, Telegram OIDC, two-factor, organizations), session/security policy and role vocabulary. Integrations for Hono and TanStack Start.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./hono": {
      "types": "./dist/middleware/hono/index.d.ts",
      "import": "./dist/middleware/hono/index.js"
    },
    "./tanstack": {
      "types": "./dist/middleware/tanstack/index.d.ts",
      "import": "./dist/middleware/tanstack/index.js"
    },
    "./tanstack/guard": {
      "types": "./dist/middleware/tanstack/guards.d.ts",
      "import": "./dist/middleware/tanstack/guards.js"
    },
    "./tanstack/server": {
      "types": "./dist/middleware/tanstack/server.d.ts",
      "import": "./dist/middleware/tanstack/server.js"
    },
    "./tanstack/client": {
      "types": "./dist/middleware/tanstack/client.d.ts",
      "import": "./dist/middleware/tanstack/client.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./env": {
      "types": "./dist/config/env.d.ts",
      "import": "./dist/config/env.js"
    },
    "./roles": {
      "types": "./dist/core/roles.d.ts",
      "import": "./dist/core/roles.js"
    },
    "./routes": {
      "types": "./dist/core/routes.d.ts",
      "import": "./dist/core/routes.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "bun check",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\"",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@abugida/database": "workspace:*",
    "@tanstack/react-router": ">=1.0.0",
    "@tanstack/react-start": ">=1.0.0",
    "better-auth": "1.6.26",
    "drizzle-orm": ">=0.45.0",
    "hono": ">=4.6.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "better-auth-telegram": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@abugida/database": "workspace:*",
    "@abugida/eslint-config": "workspace:*",
    "@abugida/prettier-config": "workspace:*",
    "@abugida/typescript-config": "workspace:*",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.169.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "better-auth": "1.6.26",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "hono": "^4.13.13",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "auth",
    "authentication",
    "better-auth",
    "oauth",
    "google",
    "telegram",
    "hono",
    "tanstack",
    "abugida"
  ]
}
