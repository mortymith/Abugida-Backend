{
  "extends": "@abugida/typescript-config/library.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.AsyncIterable"],
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "examples"]
}
