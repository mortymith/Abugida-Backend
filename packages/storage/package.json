{
  "name": "@abugida/storage",
  "version": "0.0.1",
  "description": "Shared object storage layer for the Abugida Application monorepo \u2014 S3-compatible operations, presigned URLs, multipart uploads, and key management",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/middleware/hono/index.d.ts",
      "import": "./dist/middleware/hono/index.js"
    },
    "./tanstack": {
      "types": "./dist/middleware/tanstack/index.d.ts",
      "import": "./dist/middleware/tanstack/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:integration": "bun test tests/integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@smithy/node-http-handler": "^3.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "eslint": "^10.8.1",
    "hono": "^4.6.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "keywords": [
    "storage",
    "s3",
    "minio",
    "r2",
    "presigned",
    "multipart",
    "abugida"
  ],
  "engines": {
    "bun": ">=1.4.2"
  }
}
