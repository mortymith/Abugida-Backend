{
  "name": "@abugida/storage",
  "version": "0.0.1",
  "description": "Shared object storage layer for the Abugida Application monorepo — S3-compatible operations, presigned URLs, multipart uploads, and key management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/middleware/hono/index.d.ts",
        "default": "./dist/middleware/hono/index.js"
      }
    },
    "./tanstack": {
      "import": {
        "types": "./dist/middleware/tanstack/index.d.ts",
        "default": "./dist/middleware/tanstack/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist .tsup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@smithy/node-http-handler": "^3.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "eslint": "^9.0.0",
    "hono": "^4.6.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "keywords": [
    "storage",
    "s3",
    "minio",
    "r2",
    "presigned",
    "multipart",
    "abugida"
  ],
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "bun": ">=1.3.14"
  }
}
