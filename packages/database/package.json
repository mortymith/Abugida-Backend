{
  "name": "@abugida/database",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/schema/auth/index.d.ts",
      "import": "./dist/schema/auth/index.js"
    },
    "./catalog": {
      "types": "./dist/schema/catalog/index.d.ts",
      "import": "./dist/schema/catalog/index.js"
    },
    "./finance": {
      "types": "./dist/schema/finance/index.d.ts",
      "import": "./dist/schema/finance/index.js"
    },
    "./learning": {
      "types": "./dist/schema/learning/index.d.ts",
      "import": "./dist/schema/learning/index.js"
    },
    "./ops": {
      "types": "./dist/schema/ops/index.d.ts",
      "import": "./dist/schema/ops/index.js"
    },
    "./shared": {
      "types": "./dist/schema/shared/index.d.ts",
      "import": "./dist/schema/shared/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./enums": {
      "types": "./dist/src/enums.d.ts",
      "import": "./dist/src/enums.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0",
    "zod": ">=3.23.0"
  },
  "dependencies": {
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "typescript-eslint": "^8.66.0"
  }
}
