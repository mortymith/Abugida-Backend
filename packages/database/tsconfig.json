{
  "extends": "@abugida/typescript-config/library.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["*.ts", "src/**/*.ts", "schema/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "examples", "drizzle", "drizzle.config.ts"]
}
