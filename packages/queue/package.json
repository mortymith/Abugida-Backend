{
  "name": "@abugida/queue",
  "version": "0.0.1",
  "description": "Shared message queue layer for the Abugida Application monorepo \u2013 BullMQ with Redis",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/types.js",
      "types": "./dist/core/types.d.ts"
    },
    "./integrations": {
      "import": "./dist/integrations/index.js",
      "types": "./dist/integrations/index.d.ts"
    },
    "./hono": {
      "import": "./dist/middleware/hono/client.js",
      "types": "./dist/middleware/hono/client.d.ts"
    },
    "./tanstack": {
      "import": "./dist/middleware/tanstack/client.js",
      "types": "./dist/middleware/tanstack/client.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bullmq": "^6.3.8"
  },
  "peerDependencies": {
    "hono": "^4.6.0",
    "@tanstack/react-start": "^1.112.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    }
  },
  "devDependencies": {
    "@abugida/bun-test-config": "workspace:*",
    "@abugida/eslint-config": "workspace:*",
    "@abugida/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "queue",
    "bullmq",
    "redis",
    "abugida",
    "jobs",
    "worker"
  ],
  "license": "UNLICENSED",
  "private": true
}
