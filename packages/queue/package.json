{
  "name": "@abugida/queue",
  "version": "0.0.1",
  "description": "Shared message queue layer for the Abugida Application monorepo – BullMQ with Redis",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "import": "./dist/integrations/index.js"
    },
    "./hono": {
      "types": "./dist/middleware/hono/client.d.ts",
      "import": "./dist/middleware/hono/client.js"
    },
    "./tanstack": {
      "types": "./dist/middleware/tanstack/client.d.ts",
      "import": "./dist/middleware/tanstack/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bullmq": "^6.4.0"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1.112.0",
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    }
  },
  "devDependencies": {
    "@abugida/eslint-config": "workspace:*",
    "@abugida/prettier-config": "workspace:*",
    "@abugida/typescript-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "^22.20.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "queue",
    "bullmq",
    "redis",
    "abugida",
    "jobs",
    "worker"
  ],
  "license": "MIT",
  "private": false
}
