{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env*", "pnpm-lock.yaml"],
  "ui": "tui",
  "tasks": {
    "dev": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", "build/**", ".next/**", ".vercel/**"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:pull": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "generate-routes": {
      "cache": false
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
