{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": ["arn:aws:s3:::${MINIO_BUCKET_NAME}", "arn:aws:s3:::${MINIO_BUCKET_NAME}/*"]
    }
  ]
}
