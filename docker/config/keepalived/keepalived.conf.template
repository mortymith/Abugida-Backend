# ═════════════════════════════════════════════════════════════════════
# Keepalived Configuration Template (ADR-011)
# ═══════════════════════════════════════════════════════════════════════
# Phase 8 Fix: VRRP_INTERFACE and auth_pass are
# parameterized via docker/init/resolve-vrrp-interface.sh.
# DO NOT edit this file directly.
# ═══════════════════════════════════════════════════════════════════════════════════════

global_defs {
    vrrp_garp_master_delay 1
    vrrp_garp_master_refresh 5
    interface ${VRRP_INTERFACE:-eth0}
    script_user root
    enable_script_security
}

vrrp_instance VI_EDGE {
    state MASTER
    interface ${VRRP_INTERFACE:-eth0}
    virtual_router_id 51
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass ${KEEPALIVED_AUTH_PASS:-CHANGE_ME_GENERATE_32_CHARS}
    }
    virtual_ipaddress {
        172.20.0.100/24
    }
    track_script {
        chk_caddy_active
    }
}

vrrp_script chk_caddy_active {
    script "/usr/bin/curl -sf http://127.0.1:80/health"
    interval 2
    weight -20
    fall 3
    rise 2
}
