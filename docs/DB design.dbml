// ============================================================================
// TRIGGER NOTES
// ============================================================================
/*
-- [NEW] Validate bundle_courses: course must belong to same exam_type as bundle
CREATE OR REPLACE FUNCTION validate_bundle_course_exam_type()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  bundle_exam bigint;
  course_exam bigint;
BEGIN
  SELECT exam_type_id INTO bundle_exam FROM catalog.course_bundles WHERE id = NEW.bundle_id;
  SELECT exam_type_id INTO course_exam FROM catalog.courses WHERE id = NEW.course_id;

  IF bundle_exam IS NULL THEN
    RAISE EXCEPTION 'bundle_id % does not exist', NEW.bundle_id;
  END IF;
  IF course_exam IS NULL THEN
    RAISE EXCEPTION 'course_id % does not exist', NEW.course_id;
  END IF;
  IF bundle_exam != course_exam THEN
    RAISE EXCEPTION 'Course exam_type (%) does not match bundle exam_type (%)', course_exam, bundle_exam;
  END IF;
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_validate_bundle_course
  BEFORE INSERT OR UPDATE ON catalog.bundle_courses
  FOR EACH ROW EXECUTE FUNCTION validate_bundle_course_exam_type();

-- [NEW] Recalculate bundle pricing when courses are added/removed
CREATE OR REPLACE FUNCTION recalculate_bundle_pricing()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  total numeric(19,4) := 0;
  bundle_price numeric(19,4);
  orig numeric(19,4);
BEGIN
  -- Sum individual course prices for included courses
  SELECT COALESCE(SUM(c.price_amount), 0) INTO total
  FROM catalog.bundle_courses bc
  JOIN catalog.courses c ON c.id = bc.course_id
  WHERE bc.bundle_id = COALESCE(NEW.bundle_id, OLD.bundle_id)
    AND bc.is_included = true
    AND c.deleted_at IS NULL;

  UPDATE catalog.course_bundles
  SET original_price_amount = total,
      discount_percentage = CASE
        WHEN total > 0 THEN ROUND(((total - price_amount) / total) * 100, 2)
        ELSE 0
      END
  WHERE id = COALESCE(NEW.bundle_id, OLD.bundle_id);

  RETURN COALESCE(NEW, OLD);
END;
$$;

CREATE TRIGGER trg_recalculate_bundle_pricing
  AFTER INSERT OR UPDATE OF is_included OR DELETE ON catalog.bundle_courses
  FOR EACH ROW EXECUTE FUNCTION recalculate_bundle_pricing();

-- [NEW] On bundle purchase completion, create enrollments for all included courses
CREATE OR REPLACE FUNCTION create_bundle_enrollments()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF NEW.status = 'completed' AND NEW.bundle_id IS NOT NULL AND OLD.status != 'completed' THEN
    INSERT INTO learning.enrollments (
      public_id, student_id, course_id, purchase_id, bundle_id,
      enrollment_source, progress_percentage, is_completed, row_version, created_at, updated_at
    )
    SELECT
      uuid_generate_v7(),
      NEW.student_id,
      bc.course_id,
      NEW.id,
      NEW.bundle_id,
      'bundle_purchase',
      0,
      false,
      1,
      now(),
      now()
    FROM catalog.bundle_courses bc
    WHERE bc.bundle_id = NEW.bundle_id
      AND bc.is_included = true
    ON CONFLICT (student_id, course_id) DO NOTHING;
  END IF;
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_bundle_purchase_enrollments
  AFTER UPDATE OF status ON finance.purchases
  FOR EACH ROW EXECUTE FUNCTION create_bundle_enrollments();

