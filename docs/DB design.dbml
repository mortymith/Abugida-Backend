// ============================================================================
// PARTITIONING IMPLEMENTATION NOTES
// ============================================================================
/*
-- Partitioned tables must be created with PARTITION BY clause before any data insertion.
-- The Partition blocks in this DBML indicate which tables require partitioning.

-- v2.1: Automated partition management via pg_partman + pg_cron (H1)
-- Install extensions:
CREATE EXTENSION IF NOT EXISTS pg_partman;
CREATE EXTENSION IF NOT EXISTS pg_cron;

-- For PostgreSQL declarative partitioning, create child tables:
-- audit_logs (monthly):
CREATE TABLE ops.audit_logs_2026_04 PARTITION OF ops.audit_logs
  FOR VALUES FROM ('2026-04-01') TO ('2026-05-01');

-- outbox_events (daily):
CREATE TABLE ops.outbox_events_2026_04_01 PARTITION OF ops.outbox_events
  FOR VALUES FROM ('2026-04-01') TO ('2026-04-02');

-- v2.1: Automate partition management with pg_partman extension (H1):
SELECT create_parent('ops.audit_logs', 'created_at', 'native', 'monthly');
SELECT create_parent('ops.outbox_events', 'created_at', 'native', 'daily');
SELECT create_parent('ops.security_events', 'created_at', 'native', 'monthly');

-- v2.1: Schedule automatic partition maintenance via pg_cron (H1):
SELECT cron.schedule('partman-maintenance', '@hourly',
  $$SELECT partman.run_maintenance()$$);

-- v2.1: Pre-create 3 months of future partitions to prevent insert failures:
SELECT partman.create_future_partitions('ops.audit_logs', 3);
SELECT partman.create_future_partitions('ops.outbox_events', 30);
SELECT partman.create_future_partitions('ops.security_events', 3);

-- Retention policy: drop partitions older than retention period
-- For audit_logs: keep 1 year
SELECT drop_partitions('ops.audit_logs', now() - interval '1 year');

-- For outbox_events: keep 30 days
SELECT drop_partitions('ops.outbox_events', now() - interval '30 days');
*/

// ============================================================================
// TRIGGER IMPLEMENTATION NOTES
// ============================================================================
/*
-- Updated_at trigger function (apply to all tables with updated_at column)
CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$;

-- Apply to tables:
CREATE TRIGGER trg_users_updated_at BEFORE UPDATE ON auth.users FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_user_profiles_updated_at BEFORE UPDATE ON auth.user_profiles FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_devices_updated_at BEFORE UPDATE ON auth.devices FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_education_levels_updated_at BEFORE UPDATE ON core.education_levels FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_exam_types_updated_at BEFORE UPDATE ON core.exam_types FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_courses_updated_at BEFORE UPDATE ON core.courses FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_modules_updated_at BEFORE UPDATE ON core.modules FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_resources_updated_at BEFORE UPDATE ON core.resources FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_licenses_updated_at BEFORE UPDATE ON finance.licenses FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_purchases_updated_at BEFORE UPDATE ON finance.purchases FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_user_enrollments_updated_at BEFORE UPDATE ON learning.user_enrollments FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_quiz_questions_updated_at BEFORE UPDATE ON learning.quiz_questions FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_roles_updated_at BEFORE UPDATE ON ops.roles FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_feature_flags_updated_at BEFORE UPDATE ON ops.feature_flags FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_system_configs_updated_at BEFORE UPDATE ON ops.system_configs FOR EACH ROW EXECUTE FUNCTION set_updated_at();
CREATE TRIGGER trg_file_metadata_updated_at BEFORE UPDATE ON shared.file_metadata FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- v2.1: Updated_at trigger for moderation_queue
CREATE TRIGGER trg_moderation_queue_updated_at BEFORE UPDATE ON ops.moderation_queue FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- Search vector trigger for resources table
CREATE FUNCTION resources_search_vector_update()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  NEW.search_vector :=
    setweight(to_tsvector('english', COALESCE(NEW.title, '')), 'A') ||
    setweight(to_tsvector('english', COALESCE(NEW.description, '')), 'B');
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_resources_search
  BEFORE INSERT OR UPDATE OF title, description ON core.resources
  FOR EACH ROW EXECUTE FUNCTION resources_search_vector_update();

-- v2.1: Trigger to populate resources.course_id from modules (H8)
CREATE OR REPLACE FUNCTION resources_course_id_populate()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  SELECT course_id INTO NEW.course_id
  FROM core.modules
  WHERE id = NEW.module_id;
  
  IF NEW.course_id IS NULL THEN
    RAISE EXCEPTION 'Cannot determine course_id for resource: module_id % not found', NEW.module_id;
  END IF;
  
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_resources_course_id
  BEFORE INSERT OR UPDATE OF module_id ON core.resources
  FOR EACH ROW EXECUTE FUNCTION resources_course_id_populate();

-- v2.1 CRITICAL FIX C5: Validate quiz_questions.resource_id references a quiz-type resource
CREATE OR REPLACE FUNCTION validate_quiz_question_resource_type()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  res_type resource_type;
BEGIN
  SELECT resource_type INTO res_type
  FROM core.resources
  WHERE id = NEW.resource_id;
  
  IF res_type IS NULL THEN
    RAISE EXCEPTION 'resource_id % does not exist', NEW.resource_id;
  END IF;
  
  IF res_type != 'quiz' THEN
    RAISE EXCEPTION 'resource_id % is type %, but quiz_questions requires resource_type = quiz', NEW.resource_id, res_type;
  END IF;
  
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_validate_quiz_question_resource
  BEFORE INSERT OR UPDATE OF resource_id ON learning.quiz_questions
  FOR EACH ROW EXECUTE FUNCTION validate_quiz_question_resource_type();

-- v2.1 HIGH-PRIORITY FIX H4: Validate api_keys.permissions against permissions_reference
CREATE OR REPLACE FUNCTION validate_api_key_permissions()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  perm text;
  perm_exists boolean;
BEGIN
  IF NEW.permissions IS NOT NULL AND jsonb_array_length(NEW.permissions) > 0 THEN
    FOR perm IN SELECT jsonb_array_elements_text(NEW.permissions)
    LOOP
      SELECT EXISTS(SELECT 1 FROM ops.permissions_reference WHERE permission_key = perm) INTO perm_exists;
      IF NOT perm_exists THEN
        RAISE EXCEPTION 'Permission "%" not found in permissions_reference table', perm;
      END IF;
    END LOOP;
  END IF;
  RETURN NEW;
END;
$$;

CREATE TRIGGER trg_validate_api_key_permissions
  BEFORE INSERT OR UPDATE OF permissions ON ops.api_keys
  FOR EACH ROW EXECUTE FUNCTION validate_api_key_permissions();
*/

