// ============================================================================
// Educational Mobile Application — Production Database Schema (Refactored)
// Version: 1.0 (2026-04-30 — Professional review remediation)
// Target: PostgreSQL 16
// 
// Design Conventions:
// • Internal PK: bigint serial (performance-optimized, not shard-safe — monitor growth)
// • Public ID: uuid v7 (API-safe, monotonic, supports future sharding)
// • Soft deletes: deleted_at IS NOT NULL indicates logical deletion (EXCEPT audit/event tables — see notes)
// • FK strategy: restrict for domain integrity, cascade for weak entities, set null for audit refs
// • All timestamps: timestamptz with default now()
// • Money: numeric(19,4) with explicit currency code (supports all ISO 4217 currencies including 3-decimal)
// • CHECK constraints: defined inline on columns for simplicity and portability
// • Partitioning: declared via table-level Partition statements for time-series tables
// • JSONB columns: schema validation via CHECK constraints where structural guarantees are required
//

Project EducationalMobileApp {
  database_type: 'PostgreSQL'
  Note: '''
    v2.2: Consolidated educational resources into a unified mobile platform.
    Authentication via Telegram + Google OAuth (Better Auth).
    Telebirr-only payment processing. No push notifications. No refunds.
    Ethiopia-only user scope. Maximum 3 registered devices per user.
    MVP prioritizes TOEFL/IGCSE students with phased expansion to high school and college segments.
  '''
}

// ============================================================================
// EXTENSIONS FOR POSTGRESQL
// ============================================================================
// -- Run as superuser after updating shared_preload_libraries & restarting
// CREATE EXTENSION IF NOT EXISTS pg_uuidv7;  -- for uuid_generate_v7()
// CREATE EXTENSION IF NOT EXISTS pgcrypto;
// CREATE EXTENSION IF NOT EXISTS timescaledb;  -- optional, for hypertables
// CREATE EXTENSION IF NOT EXISTS pg_trgm;
// CREATE EXTENSION IF NOT EXISTS fuzzystrmatch;
// CREATE EXTENSION IF NOT EXISTS pgaudit;
// CREATE EXTENSION IF NOT EXISTS pg_stat_statements;
// CREATE EXTENSION IF NOT EXISTS btree_gin;  -- for composite GIN indexes
// CREATE EXTENSION IF NOT EXISTS pg_partman; -- automated partition management (v2.1)
// CREATE EXTENSION IF NOT EXISTS pg_cron;    -- scheduled jobs for partition maintenance (v2.1)
// CREATE EXTENSION IF NOT EXISTS btree_gist; -- for exclusion constraints (study_goals overlap) (v2.1)

// ============================================================================
// ENUM DEFINITIONS (Type Safety & Validation)
// ============================================================================
Enum account_status {
  pending_verification [note: 'Email/SMS verification pending']
  active [note: 'Fully verified and active']
  locked [note: 'Temporarily locked due to failed attempts or security']
  suspended [note: 'Administrative suspension']
  deleted [note: 'Account marked for deletion (GDPR erasure pending)']
}

Enum platform {
  ios
  android
}

Enum consent_type {
  essential [note: 'Required for app functionality (no opt-out)']
  analytics [note: 'Usage tracking and crash reporting']
  personalization [note: 'Content recommendations']
  marketing [note: 'Promotional communications']
  third_party_sharing [note: 'Sharing anonymized data with third-party partners']
}

// v2.2: REMOVED — verification_purpose enum (no OTP/SMS verification in social-login model)

Enum education_segment {
  toefl
  igcse
  high_school
  college
}

Enum resource_type {
  pdf
  video
  quiz
  exercise
  link
}

Enum license_type {
  perpetual [note: 'No expiration']
  subscription [note: 'Time-limited with auto-renewal option']
  limited_use [note: 'Fixed number of accesses or specific date range']
  open_source [note: 'Freely usable with attribution']
}

Enum license_status {
  active [note: 'License valid and enforceable']
  expiring_soon [note: '30 days or less until expiration']
  expired [note: 'Beyond end_date without grace period']
  revoked [note: 'Terminated early by licensor']
}

Enum payment_provider {
  telebirr [note: 'Ethiopian mobile money — sole payment method']
}

Enum purchase_status {
  initiated
  payment_pending
  completed
  failed
}

Enum transaction_type {
  authorization
  capture
}

Enum transaction_status {
  pending
  succeeded
  failed
}

Enum enrollment_source {
  purchase
  free_access
  admin_grant
  preview
}

Enum user_feedback_type {
  thumbs_up
  thumbs_down
}

Enum moderation_status {
  pending
  approved
  rejected
  edited [note: 'Content modified by moderator']
}

// v2.2: REMOVED — notification_type enum (push notifications not in MVP scope)

Enum audit_action {
  user_login
  user_logout
  purchase_completed
  resource_access
  admin_action
  data_export
  permission_change
  content_moderation
}

Enum security_event_type {
  failed_login
  account_lockout
  suspicious_ip
  token_reuse
  rate_limit_exceeded
  permission_denied
}

Enum severity_level {
  info
  warning
  critical
}

Enum flag_type {
  boolean
  percentage
  user_segment
  date_range
}

Enum job_status {
  pending
  processing
  completed
  failed
  retrying
}

Enum webhook_processing_status {
  received
  verified
  processed
  failed
}

Enum login_attempt_type {
  oauth_login
  token_refresh
}

// ============================================================================
// TABLE DEFINITIONS (Grouped by Schema)
// ============================================================================

// ============================================================================
// SCHEMA: auth
// ============================================================================
Table auth.users {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  // v2.2: Social-login only (Telegram + Google via Better Auth).
  // Phone number fields are nullable — no OTP/password authentication.
  phone_number_encrypted bytea [note: 'AES-256-GCM encrypted at application layer. NULL for social-login users.']
  phone_number_hash varchar(64) [note: 'SHA-256 hash of plaintext phone. NULL for social-login users.']
  phone_number_last4 char(4) [note: 'Last 4 digits for support/correlation. NULL for social-login users.']
  hash_version smallint [default: 1]
  // v2.2: Removed password_hash and password_hash_salt (no password model in social-login)
  device_count integer [not null, default: 0, note: 'Number of registered devices for this user']
  max_devices integer [not null, default: 3, note: 'Maximum registered devices allowed (configurable)']
  display_name varchar(100)
  account_status account_status [not null, default: "active"]
  failed_login_attempts smallint [not null, default: 0, check: `failed_login_attempts >= 0`]
  locked_until timestamptz [note: 'If locked, account unlocks after this timestamp']
  last_login_at timestamptz
  last_active_at timestamptz
  // v2.2 GDPR compliance: SLA tracking for FR-904 deletion requests
  deletion_requested_at timestamptz [note: 'Timestamp when user requested GDPR erasure. NULL if not requested.']
  deletion_completed_at timestamptz [note: 'Timestamp when erasure process completed. Enables 30-day SLA tracking per FR-904.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: '''
    v2.2: Central identity table for social-login only (Telegram + Google via Better Auth).
    Password fields removed — no password model. Phone number fields nullable (not required for social login).
    Device_count and max_devices enforce the 3-device registration limit.
    account_status defaults to active (no email/SMS verification step for social login).
    Soft-delete via deleted_at; hard delete requires GDPR erasure process.
  '''

  Indexes {
    (public_id) [unique, name: "idx_users_public_id"]
    (phone_number_hash) [type: hash, unique, name: "idx_users_phone_hash", note: 'Hash-based index for authentication lookups (nullable — social-login users may not have phone)']
    (phone_number_last4) [name: "idx_users_phone_last4", note: 'For support correlation queries']
    (account_status) [name: "idx_users_status"]
    (account_status, phone_number_hash) [name: "idx_users_active_query", note: 'Filter on deleted_at IS NULL at query time']
    (deleted_at) [name: "idx_users_deleted"]
    (deletion_requested_at) [name: "idx_users_deletion_sla", note: 'For monitoring GDPR 30-day SLA compliance (FR-904)']
  }
}

Table auth.user_profiles {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  avatar_object_key varchar(500)
  email varchar(254) [note: 'Optional email address for notifications and support.']
  education_segment education_segment [note: 'User-selected education segment from registration.']
  // v2.1: Added CHECK constraint for known notification preference keys
  notification_preferences jsonb [not null, default: '{}', note: '{"email_enabled": false, "sms_enabled": false}', check: `notification_preferences IS NULL OR (jsonb_typeof(notification_preferences) = 'object' AND (notification_preferences ? 'email_enabled' OR notification_preferences ? 'sms_enabled' OR notification_preferences = '{}'::jsonb))`]
  language_preference varchar(10) [not null, default: 'en']
  timezone varchar(50) [not null, default: 'Africa/Addis_Ababa']
  exam_preferences jsonb [not null, default: '[]', note: '["TOEFL", "IGCSE"] — selected exam types during onboarding (FR-110)']
  onboarding_completed boolean [not null, default: false]
  onboarding_step smallint [not null, default: 0, check: `onboarding_step >= 0 AND onboarding_step <= 5`, note: '0=not started, 5=completed']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'One-to-one extension of users table for profile data that is frequently updated.'

  Indexes {
    (public_id) [unique, name: "idx_user_profiles_public"]
    (user_id) [unique, name: "idx_user_profiles_user", note: 'FK is already unique; this index supports JOIN performance']
  }
}

Table auth.devices {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  device_identifier varchar(255) [not null, note: 'Device fingerprint']
  device_name varchar(100) [note: 'User-friendly device name']
  platform varchar(50) [note: 'iOS, Android, Web']
  os_version varchar(50) [check: `os_version IS NULL OR os_version ~ '^\d+(\.\d+)+$'`, note: 'Semver format validation']
  app_version varchar(20) [check: `app_version IS NULL OR app_version ~ '^\d+\.\d+\.\d+$'`, note: 'Semver format: major.minor.patch']
  last_active_at timestamptz [not null, default: `now()`]
  registered_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true]
  deleted_at timestamptz

  Note: '''
    v2.2: Redesigned device registration table.
    Enforces maximum 3 active devices per user via trigger/application constraint.
    Removed push_token (push notifications not in MVP scope).
    Removed is_trusted, is_primary_user (simplified device model).
    UNIQUE constraint on (user_id, device_identifier) ensures one registration per device per user.
  '''

  Indexes {
    (public_id) [unique, name: "idx_devices_public"]
    (user_id, device_identifier) [unique, name: "idx_devices_user_identifier", note: 'One registration per device per user']
    (user_id, last_active_at) [name: "idx_devices_user_active", note: 'For finding least-recently-used device when enforcing 3-device limit']
  }
}

// v2.2: Trigger/constraint to enforce maximum 3 active devices per user
// Stored procedure: remove oldest inactive device when limit is reached

Table auth.user_consents {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  consent_type consent_type [not null]
  consent_version varchar(20) [not null, note: 'Version of the consent form (e.g., "2025-01-01_v1")']
  is_granted boolean [not null]
  ip_address inet
  consented_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Immutable audit trail of user consent. Revocation = new row with is_granted=false, not update.'

  Indexes {
    (public_id) [unique, name: "idx_consents_public"]
    (user_id, consent_type, consent_version) [unique, name: "idx_consents_unique"]
    (user_id) [name: "idx_consents_user"]
  }
}

// v2.2: REMOVED — user_sessions and refresh_tokens tables.
// Option A (Recommended): Session management delegated to Better Auth native session store.
// Better Auth handles JWT issuance, refresh token rotation, and session invalidation internally.
// This eliminates the need for custom session/refresh token tables in the application schema.

Table auth.login_attempts {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  phone_number_last4 char(4) [not null, note: 'Last 4 digits for correlation without PII exposure']
  ip_address inet [not null]
  user_agent varchar(500)
  attempt_type login_attempt_type [not null, note: 'Enum replaces unconstrained varchar(20)']
  is_successful boolean [not null]
  failure_reason varchar(100)
  attempted_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Append-only security audit table. No soft-delete per compliance requirements.'

  Indexes {
    (public_id) [unique, name: "idx_login_attempts_public"]
    (phone_number_last4, attempted_at) [name: "idx_login_attempts_phone_time"]
    (ip_address, attempted_at) [name: "idx_login_attempts_ip_time"]
    (attempted_at) [name: "idx_login_attempts_time"]
  }
}

// v2.2: REMOVED — sms_verifications table no longer needed (no OTP flow in social-login model)
// OTP-based authentication has been replaced by Telegram + Google OAuth via Better Auth.

// v2.2: REMOVED — password_history table no longer needed (no password model in social-login only)
// Authentication is handled entirely by Telegram + Google OAuth via Better Auth.

// ============================================================================
// SCHEMA: core
// ============================================================================
Table core.education_levels {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  name varchar(100) [not null]
  slug varchar(100) [not null]
  description text
  sort_order smallint [not null, default: 0, check: `sort_order >= 0`, note: 'Standardized naming']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_education_levels_public"]
    (slug) [unique, name: "idx_education_levels_slug"]
    (is_active, sort_order) [name: "idx_education_levels_active_order"]
  }
}

Table core.exam_types {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  education_level_id bigint [not null]
  name varchar(100) [not null]
  slug varchar(100) [not null]
  description text
  parent_exam_type_id bigint
  sort_order smallint [not null, default: 0, check: `sort_order >= 0`]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_exam_types_public"]
    (education_level_id, sort_order) [name: "idx_exam_types_level_order"]
    (education_level_id, slug) [unique, name: "idx_exam_types_level_slug"]
  }
}

Table core.courses {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  exam_type_id bigint [not null]
  title varchar(300) [not null]
  slug varchar(300) [not null]
  description text
  thumbnail_object_key varchar(500)
  price_amount numeric(19, 4) [check: `price_amount IS NULL OR price_amount >= 0`, note: 'ISO 4217 compliant precision — supports 3-decimal currencies']
  price_currency char(3) [not null, default: 'ETB', check: `price_currency ~ '^[A-Z]{3}$'`]
  is_free boolean [not null, default: false]
  is_published boolean [not null, default: false]
  published_at timestamptz
  version integer [not null, default: 1, check: `version >= 1`]
  sort_order smallint [not null, default: 0, check: `sort_order >= 0`]
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_courses_public"]
    (exam_type_id, is_published, sort_order) [name: "idx_courses_list_query"]
    (slug) [unique, name: "idx_courses_slug"]
    (is_published, is_free) [name: "idx_courses_discovery"]
  }
}

// v2.1 CRITICAL FIX C3: Added missing course_stats table for FR-702 and FR-808
Table core.course_stats {
  course_id bigint [pk, note: 'Sole PK — one row per course. FK to core.courses.id']
  total_enrollments integer [not null, default: 0, check: `total_enrollments >= 0`]
  active_users_7d integer [not null, default: 0, check: `active_users_7d >= 0 AND active_users_7d <= total_enrollments`]
  downloads_30d integer [not null, default: 0, check: `downloads_30d >= 0`]
  purchase_count integer [not null, default: 0, check: `purchase_count >= 0 AND purchase_count <= total_enrollments`]
  average_rating numeric(3, 2) [check: `average_rating IS NULL OR (average_rating >= 1.0 AND average_rating <= 5.0)`]
  rating_count integer [not null, default: 0, check: `rating_count >= 0`]
  weighted_rating numeric(4, 3) [note: 'FR-702: 70% recent (30d) + 30% older ratings, recalculated daily']
  popularity_score numeric(10, 4) [note: 'FR-808: (0.4 × downloads_last_30d) + (0.3 × active_users_last_7d) + (0.3 × purchase_count), exponentially decayed']
  calculated_at timestamptz [not null, default: `now()`, note: 'Last time metrics were recomputed']

  Note: '''
    v2.1: Materialized metrics table for admin dashboard and recommendation engine.
    Recalculated daily via scheduled job or trigger on underlying events.
    Single PK on course_id ensures one row per course — resolves v2.0 dual PK anomaly.
    Supports FR-702 (weighted ratings), FR-705 (popularity recommendations), FR-808 (popularity metric).
  '''

  Indexes {
    (popularity_score) [name: "idx_course_stats_popularity", note: 'For FR-705 popularity-based recommendations']
    (weighted_rating) [name: "idx_course_stats_rating", note: 'For FR-706 sort by rating']
    (calculated_at) [name: "idx_course_stats_calculated", note: 'For monitoring staleness']
  }
}

Table core.modules {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  course_id bigint [not null]
  title varchar(300) [not null]
  description text
  sort_order smallint [not null, check: `sort_order >= 0`, note: 'Standardized naming (was module_order)']
  estimated_duration_minutes integer [check: `estimated_duration_minutes IS NULL OR estimated_duration_minutes > 0`]
  is_preview_available boolean [not null, default: false]
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_modules_public"]
    (course_id, sort_order) [unique, name: "idx_modules_course_order"]
    (course_id) [name: "idx_modules_course"]
  }
}

Table core.resources {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  module_id bigint [not null]
  // v2.1 HIGH-PRIORITY FIX H8: Denormalized course_id for performance (eliminates 3-table joins)
  course_id bigint [note: 'v2.1: Denormalized from modules.course_id via trigger. Eliminates 3-table joins for course-level queries.', check: `course_id IS NOT NULL`]
  title varchar(300) [not null]
  description text
  resource_type resource_type [not null]
  file_object_key varchar(500)
  file_size_bytes bigint [check: `file_size_bytes IS NULL OR file_size_bytes >= 0`]
  mime_type varchar(100)
  duration_seconds integer [check: `duration_seconds IS NULL OR duration_seconds >= 0`]
  page_count smallint [check: `page_count IS NULL OR page_count > 0`, note: 'CRITICAL FIX: Removed 100-page cap (was constraint error). 32,767 max sufficient for any textbook.']
  current_version integer [not null, default: 1, check: `current_version >= 1`]
  is_downloadable boolean [not null, default: true]
  download_size_limit_bytes bigint [not null, default: 524288000, check: `download_size_limit_bytes >= 0`]
  search_vector tsvector
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Resources require a trigger to maintain search_vector on title/description changes and to populate course_id from modules. See -- TRIGGER NOTES.'

  Indexes {
    (public_id) [unique, name: "idx_resources_public"]
    (module_id) [name: "idx_resources_module"]
    (course_id) [name: "idx_resources_course", note: 'v2.1: Supports course-level queries without joining through modules']
    (resource_type) [name: "idx_resources_type"]
    (search_vector) [type: gin, name: "idx_resources_search"]
  }
}

Table core.resource_versions {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  resource_id bigint [not null]
  version_number integer [not null, check: `version_number >= 1`]
  file_object_key varchar(500) [not null]
  file_size_bytes bigint [check: `file_size_bytes >= 0`]
  change_log text
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_resource_versions_public"]
    (resource_id, version_number) [unique, name: "idx_resource_versions_unique"]
    (resource_id) [name: "idx_resource_versions_resource"]
  }
}

Table core.content_tags {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  name varchar(100) [not null]
  slug varchar(100) [not null]
  description text
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_content_tags_public"]
    (slug) [unique, name: "idx_content_tags_slug"]
  }
}

Table core.resource_tags {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  resource_id bigint [not null]
  tag_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (public_id) [unique, name: "idx_resource_tags_public"]
    (resource_id, tag_id) [unique, name: "idx_resource_tags_unique"]
    (tag_id) [name: "idx_resource_tags_tag"]
  }
}

// ============================================================================
// SCHEMA: finance
// ============================================================================
Table finance.licenses {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  resource_id bigint [not null]
  license_type license_type [not null]
  license_terms text
  start_date date [not null]
  end_date date [check: `end_date IS NULL OR end_date >= start_date`, note: 'NULL end_date allowed for perpetual/open_source']
  auto_renewal boolean [not null, default: false]
  renewal_reminder_days integer [not null, default: 30, check: `renewal_reminder_days >= 0 AND renewal_reminder_days <= 365`]
  status license_status [not null, default: 'active']
  grace_period_days integer [not null, default: 90, check: `grace_period_days >= 0 AND grace_period_days <= 365`]
  licensor_name varchar(200)
  licensor_contact varchar(300)
  cost_amount numeric(19, 4) [check: `cost_amount IS NULL OR cost_amount >= 0`]
  cost_currency char(3) [not null, default: 'ETB', check: `cost_currency ~ '^[A-Z]{3}$'`]
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_licenses_public"]
    (resource_id, status) [name: "idx_licenses_resource_status"]
    (end_date, status) [name: "idx_licenses_expiry_monitor"]
  }
}

Table finance.license_grants {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  license_id bigint [not null]
  user_id bigint [not null]
  purchase_id bigint
  granted_at timestamptz [not null, default: `now()`]
  access_expires_at timestamptz [not null]
  is_active boolean [not null, default: true]
  revoked_at timestamptz
  revoke_reason varchar(200)
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_license_grants_public"]
    (user_id, is_active) [name: "idx_license_grants_user_active"]
    (license_id, is_active) [name: "idx_license_grants_license_active"]
    (access_expires_at) [name: "idx_license_grants_expiry"]
    (purchase_id) [name: "idx_license_grants_purchase"]
  }
}

Table finance.payment_gateways {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  provider_name payment_provider [not null]
  display_name varchar(100) [not null]
  platform_restriction varchar(15) [check: `platform_restriction = 'all'`, note: 'v2.2: Telebirr available on all platforms']
  is_enabled boolean [not null, default: true]
  requires_disclosure boolean [not null, default: false]
  disclosure_text text
  api_config jsonb [not null, default: '{}', note: '{"merchant_id": "...", "public_key_ref": "arn:aws:secretsmanager:..."}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_payment_gateways_public"]
    (provider_name) [unique, name: "idx_payment_gateways_provider"]
    (is_enabled, platform_restriction) [name: "idx_payment_gateways_filter"]
  }
}

Enum purchase_platform {
  ios
  android
  web
}

Table finance.purchase_options {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  course_id bigint [not null]
  payment_gateway_id bigint [not null]
  platform purchase_platform [not null]
  product_id varchar(255) [not null]
  display_name varchar(150) [not null]
  description text
  duration_days integer [not null, check: `duration_days > 0`]
  price_amount numeric(19, 4) [not null, check: `price_amount >= 0`]
  price_currency char(3) [not null, default: 'ETB', check: `price_currency ~ '^[A-Z]{3}$'`]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_purchase_options_public"]
    (course_id, platform, is_active) [name: "idx_purchase_options_course_platform"]
    (payment_gateway_id) [name: "idx_purchase_options_gateway"]
  }
}

Table finance.purchases {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  course_id bigint [not null]
  purchase_option_id bigint [not null, note: 'v2.2: Now NOT NULL — purchase option is always required']
  payment_gateway_id bigint [not null]
  status purchase_status [not null, default: 'initiated']
  amount numeric(19, 4) [not null, check: `amount >= 0`, note: 'ISO 4217 compliant precision']
  currency char(3) [not null, default: 'ETB', check: `currency ~ '^[A-Z]{3}$'`]
  receipt_object_key varchar(500)
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'v2.2: Telebirr-only purchases. Removed platform_fee_amount (no Apple/Google fees). No refund fields (no refunds for Ethiopian users).'

  Indexes {
    (public_id) [unique, name: "idx_purchases_public"]
    (user_id, created_at) [name: "idx_purchases_user_time"]
    (course_id) [name: "idx_purchases_course"]
    (purchase_option_id) [name: "idx_purchases_option"]
    (status) [name: "idx_purchases_status"]
    (user_id, course_id) [name: "idx_purchases_user_course"]
  }
}

Table finance.purchase_transactions {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  purchase_id bigint [not null]
  transaction_type transaction_type [not null]
  external_transaction_id varchar(255)
  amount numeric(19, 4) [not null, check: `amount >= 0`]
  currency char(3) [not null, default: 'ETB', check: `currency ~ '^[A-Z]{3}$'`]
  status transaction_status [not null, default: 'pending']
  validation_response jsonb
  error_message text
  idempotency_key varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'v2.2: Telebirr-only transactions. Removed external_receipt_data, refund_reason, refund_policy_applied (no refunds, no Apple/Google).'

  Indexes {
    (public_id) [unique, name: "idx_purchase_transactions_public"]
    (purchase_id) [name: "idx_purchase_transactions_purchase"]
    (external_transaction_id) [name: "idx_purchase_transactions_external"]
    (idempotency_key) [unique, name: "idx_purchase_transactions_idempotent"]
    (status, created_at) [name: "idx_purchase_transactions_pending"]
  }
}

// ============================================================================
// SCHEMA: learning
// ============================================================================

Table learning.user_enrollments {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  course_id bigint [not null]
  purchase_id bigint
  enrollment_source enrollment_source [not null, default: 'purchase']
  progress_percentage numeric(5, 2) [not null, default: 0, check: `progress_percentage >= 0 AND progress_percentage <= 100`]
  is_completed boolean [not null, default: false]
  completed_at timestamptz
  last_accessed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_enrollments_public"]
    (user_id, course_id) [unique, name: "idx_enrollments_unique"]
    (user_id, last_accessed_at) [name: "idx_enrollments_user_recent"]
    (course_id, is_completed) [name: "idx_enrollments_course_completion"]
  }
}

Table learning.quiz_questions {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  resource_id bigint [not null, note: 'v2.1 CRITICAL FIX C5: Must reference a resource with resource_type = quiz. Enforced via trigger.']
  version_number integer [not null, check: `version_number >= 1`]
  question_index smallint [not null, check: `question_index >= 0`]
  question_text text [not null]
  correct_answer text [not null]
  explanation text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Normalized from quiz_answers — resolves 2NF violation (question_text depends on question_index, not quiz_attempt_id). v2.1: FK validation trigger ensures resource_id references a quiz-type resource.'

  Indexes {
    (public_id) [unique, name: "idx_quiz_questions_public"]
    (resource_id, version_number, question_index) [unique, name: "idx_quiz_questions_unique"]
    (resource_id) [name: "idx_quiz_questions_resource"]
  }
}

Table learning.quiz_attempts {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  resource_id bigint [not null]
  attempt_number smallint [not null, check: `attempt_number >= 1`]
  total_questions smallint [not null, check: `total_questions > 0`]
  correct_answers smallint [not null, check: `correct_answers >= 0 AND correct_answers <= total_questions`]
  score_percentage numeric(5, 2) [not null, check: `score_percentage >= 0 AND score_percentage <= 100`]
  passed boolean [not null]
  duration_seconds integer [check: `duration_seconds IS NULL OR duration_seconds >= 0`]
  started_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_quiz_attempts_public"]
    (user_id, resource_id) [name: "idx_quiz_attempts_user_resource"]
    (user_id, created_at) [name: "idx_quiz_attempts_user_time"]
    (resource_id, passed) [name: "idx_quiz_attempts_resource_pass"]
  }
}

Table learning.quiz_answers {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  quiz_attempt_id bigint [not null]
  question_id bigint [not null, note: 'FK to quiz_questions.id — replaces question_text/correct_answer duplication']
  user_answer text
  is_correct boolean [not null]
  answered_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Refactored: removed denormalized question_text and correct_answer. Now references quiz_questions.'

  Indexes {
    (public_id) [unique, name: "idx_quiz_answers_public"]
    (quiz_attempt_id, question_id) [unique, name: "idx_quiz_answers_unique"]
    (quiz_attempt_id) [name: "idx_quiz_answers_attempt"]
    (question_id) [name: "idx_quiz_answers_question"]
  }
}

Table learning.course_reviews {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  course_id bigint [not null]
  rating smallint [not null, check: `rating >= 1 AND rating <= 5`]
  title varchar(200) [not null]
  content text [not null]
  moderation_status moderation_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_course_reviews_public"]
    (course_id, rating) [name: "idx_course_reviews_course_rating"]
    (user_id, course_id) [unique, name: "idx_course_reviews_user_course"]
    (moderation_status, created_at) [name: "idx_course_reviews_status_time"]
  }
}

// ============================================================================
// SCHEMA: ops
// ============================================================================
Table ops.audit_logs {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  actor_id bigint
  actor_ip inet
  action audit_action [not null]
  resource_type varchar(50)
  resource_id bigint
  old_values jsonb
  new_values jsonb
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Immutable security and compliance audit trail. Partitioned by created_at monthly. No soft-delete — deletion would violate audit integrity requirements.'

  Indexes {
    (public_id) [unique, name: "idx_audit_logs_public"]
    (actor_id, created_at) [name: "idx_audit_logs_actor_time"]
    (action, created_at) [name: "idx_audit_logs_action_time"]
    (resource_type, resource_id) [name: "idx_audit_logs_resource"]
  }
}

Table ops.principals {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  principal_type varchar(20) [not null, check: `principal_type IN ('user', 'service', 'integration')`, note: 'Discriminator column for polymorphic FK resolution']
  user_id bigint [check: `(principal_type = 'user' AND user_id IS NOT NULL) OR (principal_type != 'user' AND user_id IS NULL)`]
  service_name varchar(100) [check: `(principal_type = 'service' AND service_name IS NOT NULL) OR (principal_type != 'service' AND service_name IS NULL)`]
  integration_name varchar(100) [check: `(principal_type = 'integration' AND integration_name IS NOT NULL) OR (principal_type != 'integration' AND integration_name IS NULL)`]
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Abstract principal table to resolve polymorphic FK in api_keys. Replaces owner_type/owner_id pattern without referential integrity.'

  Indexes {
    (public_id) [unique, name: "idx_principals_public"]
    (principal_type) [name: "idx_principals_type"]
    (user_id) [unique, name: "idx_principals_user"]
    (service_name) [unique, name: "idx_principals_service"]
    (integration_name) [unique, name: "idx_principals_integration"]
  }
}

Table ops.roles {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  name varchar(50) [not null]
  description text
  permissions jsonb [not null, default: '[]', note: '["users:read", "content:manage", "finance:view"]']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_roles_public"]
    (name) [unique, name: "idx_roles_name"]
  }
}

Table ops.user_roles {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  role_id bigint [not null]
  granted_by bigint
  granted_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_user_roles_public"]
    (user_id, role_id) [unique, name: "idx_user_roles_unique"]
    (role_id) [name: "idx_user_roles_role"]
  }
}

// v2.1 HIGH-PRIORITY FIX H4: Permissions reference table for api_keys validation
Table ops.permissions_reference {
  permission_key varchar(100) [pk, note: 'e.g., "users:read", "content:manage", "finance:view"']
  description text
  resource_scope varchar(50) [note: 'High-level resource category: users, content, finance, analytics, admin']
  is_deprecated boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    v2.1: Registry of valid permissions for api_keys.permissions JSONB validation.
    Trigger on api_keys validates all array elements exist in this table.
    Enables permissions documentation, deprecation tracking, and safe permission management.
  '''

  Indexes {
    (resource_scope) [name: "idx_permissions_reference_scope"]
  }
}

Table ops.security_events {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  event_type security_event_type [not null]
  actor_id bigint
  actor_ip inet
  severity severity_level [not null, default: 'info']
  description text [not null]
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Immutable security incident log. Partitioned by created_at monthly. No soft-delete.'

  Indexes {
    (public_id) [unique, name: "idx_security_events_public"]
    (event_type, created_at) [name: "idx_security_events_type_time"]
    (severity, created_at) [name: "idx_security_events_severity_time"]
    (created_at) [name: "idx_security_events_time"]
  }
}

Table ops.feature_flags {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  flag_key varchar(100) [not null]
  description text
  flag_type flag_type [not null]
  is_enabled boolean [not null, default: false]
  // v2.1 HIGH-PRIORITY FIX H7: Added consistency CHECK between is_enabled and rollout_percentage
  rollout_percentage smallint [check: `(is_enabled = false AND rollout_percentage IS NULL) OR (is_enabled = true AND rollout_percentage IS NOT NULL AND rollout_percentage >= 0 AND rollout_percentage <= 100)`, note: 'v2.1: is_enabled=false requires null rollout_percentage; is_enabled=true requires 0-100.']
  target_segments jsonb
  start_date timestamptz
  end_date timestamptz [check: `end_date IS NULL OR end_date > start_date`]
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_feature_flags_public"]
    (flag_key) [unique, name: "idx_feature_flags_key"]
    (is_enabled, flag_type) [name: "idx_feature_flags_filter"]
  }
}

Table ops.system_configs {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  config_key varchar(100) [not null]
  config_value jsonb [not null, note: 'Actual secrets MUST reference AWS Secrets Manager/HashiCorp Vault. This table stores only configuration metadata and safe-to-DB values.']
  description text
  is_sensitive boolean [not null, default: false]
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Sensitive config values must not be stored directly. Use is_sensitive flag to enforce Vault reference pattern via CHECK constraint.'

  Indexes {
    (public_id) [unique, name: "idx_system_configs_public"]
    (config_key) [unique, name: "idx_system_configs_key"]
  }
}

Table ops.outbox_events {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  aggregate_type varchar(100) [not null]
  aggregate_id uuid [not null]
  event_type varchar(200) [not null]
  event_data jsonb [not null]
  metadata jsonb [not null, default: '{}']
  is_published boolean [not null, default: false, note: 'Renamed from "published" for positive framing consistency']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Transactional outbox pattern for reliable event delivery. Partitioned by created_at daily.'


  Indexes {
    (public_id) [unique, name: "idx_outbox_events_public"]
    (is_published, created_at) [name: "idx_outbox_events_publisher_poll"]
    (aggregate_type, aggregate_id) [name: "idx_outbox_events_aggregate"]
    (created_at) [name: "idx_outbox_events_time"]
  }
}

Table ops.webhook_events {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  provider payment_provider [not null, note: 'Telebirr only (sole payment provider)']
  event_type varchar(100) [not null]
  raw_payload jsonb [not null]
  signature_header varchar(500)
  is_verified boolean [not null, default: false]
  processing_status webhook_processing_status [not null, default: 'received']
  error_message text
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_webhook_events_public"]
    (processing_status, received_at) [name: "idx_webhook_events_processing"]
    (provider, event_type) [name: "idx_webhook_events_provider_type"]
    (received_at) [name: "idx_webhook_events_time"]
  }
}

Table ops.api_keys {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  principal_id bigint [not null, note: 'FK to principals.id — resolves polymorphic owner issue']
  key_hash varchar(255) [not null]
  key_hash_salt bytea [not null]
  key_prefix varchar(10) [not null]
  permissions jsonb [not null, default: '[]', note: 'v2.1: ["users:read", "content:manage"] — validated against ops.permissions_reference']
  is_active boolean [not null, default: true]
  last_used_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  deleted_at timestamptz

  Note: 'Refactored polymorphic owner_type/owner_id → single FK to principals table. v2.1: Permissions validated against permissions_reference table.'

  Indexes {
    (public_id) [unique, name: "idx_api_keys_public"]
    (key_hash) [unique, name: "idx_api_keys_hash"]
    (principal_id) [name: "idx_api_keys_principal"]
    (is_active, expires_at) [name: "idx_api_keys_active"]
  }
}

Table ops.job_queue {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  job_type varchar(100) [not null]
  job_data jsonb [not null]
  status job_status [not null, default: 'pending']
  priority smallint [not null, default: 0, check: `priority >= 0 AND priority <= 10`]
  scheduled_at timestamptz
  max_retries smallint [not null, default: 3, check: `max_retries >= 0 AND max_retries <= 10`]
  retry_count smallint [not null, default: 0, check: `retry_count >= 0 AND retry_count <= max_retries`]
  retry_backoff_seconds integer [not null, default: 60, check: `retry_backoff_seconds > 0`]
  last_error text
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    (public_id) [unique, name: "idx_job_queue_public"]
    (status, priority, scheduled_at) [name: "idx_job_queue_worker_poll"]
    (job_type, status) [name: "idx_job_queue_type_status"]
    (scheduled_at) [name: "idx_job_queue_scheduled"]
  }
}

// v2.1 MEDIUM FIX M1: Moderation queue table for FR-803 review pipeline
Table ops.moderation_queue {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  content_type varchar(50) [not null, note: 'e.g., "review", "resource_report", "user_report"']
  content_id bigint [not null, note: 'ID in the source table (e.g., review ID)']
  status moderation_status [not null, default: 'pending']
  submitted_by bigint [note: 'User who submitted the content for review']
  assigned_to bigint [note: 'Admin/moderator assigned to review']
  priority smallint [not null, default: 0, check: `priority >= 0 AND priority <= 10`, note: '10 = urgent']
  submitted_at timestamptz [not null, default: `now()`]
  // v2.1: SLA tracking for FR-803 "48-hour moderation SLA"
  sla_deadline_at timestamptz [not null, note: 'v2.1: Set to submitted_at + 48 hours for FR-803 SLA tracking']
  resolved_at timestamptz
  resolution_note text
  auto_flagged_reasons jsonb [note: 'v2.1: e.g., ["profanity_filter", "spam_detected"] — from automated screening']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    v2.1: Moderation pipeline for user-submitted content (FR-803).
    Supports reviews, resource reports, and user reports.
    SLA tracking via sla_deadline_at for 48-hour moderation commitment.
    Auto-flagged reasons from automated profanity/spam detection.
  '''

  Indexes {
    (public_id) [unique, name: "idx_moderation_queue_public"]
    (status, priority, sla_deadline_at) [name: "idx_moderation_queue_worker", note: 'For moderator dashboard: pending items sorted by priority/SLA']
    (assigned_to, status) [name: "idx_moderation_queue_assignee"]
    (submitted_by) [name: "idx_moderation_queue_submitter"]
    (sla_deadline_at) [name: "idx_moderation_queue_sla", note: 'For FR-807 alerts: items >48 hours old']
  }
}


// ============================================================================
// SCHEMA: shared
// ============================================================================
Table shared.file_metadata {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  object_key varchar(500) [not null]
  bucket_name varchar(100) [not null]
  original_filename varchar(500)
  mime_type varchar(100)
  file_size_bytes bigint [check: `file_size_bytes >= 0`]
  checksum_sha256 varchar(64)
  encryption_key_reference varchar(500)
  is_public boolean [not null, default: false]
  // v2.1 MEDIUM FIX M7: FK reference to resource_versions for file ownership tracking
  resource_version_id bigint [note: 'v2.1: FK to core.resource_versions.id — tracks which resource version owns this file']
  uploaded_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'Central file metadata registry. v2.1: resource_version_id links file to its owning resource version for ownership tracking.'

  Indexes {
    (public_id) [unique, name: "idx_file_metadata_public"]
    (object_key) [unique, name: "idx_file_metadata_object_key"]
    (bucket_name) [name: "idx_file_metadata_bucket"]
    (uploaded_by, created_at) [name: "idx_file_metadata_uploader_time"]
    (resource_version_id) [name: "idx_file_metadata_resource_version", note: 'v2.1: For finding all files belonging to a resource version']
  }
}

