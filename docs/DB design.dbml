-- Reduce index bloat on tables with soft deletes:
-- Only index non-deleted rows where queries typically filter on deleted_at IS NULL.

CREATE INDEX idx_courses_active_list ON core.courses (exam_type_id, is_published, sort_order)
  WHERE deleted_at IS NULL;

CREATE INDEX idx_modules_course_active ON core.modules (course_id, sort_order)
  WHERE deleted_at IS NULL;

CREATE INDEX idx_resources_module_active ON core.resources (module_id)
  WHERE deleted_at IS NULL;

CREATE INDEX idx_user_enrollments_active ON learning.user_enrollments (user_id, last_accessed_at)
  WHERE deleted_at IS NULL;

CREATE INDEX idx_licenses_active ON finance.licenses (resource_id, status)
  WHERE deleted_at IS NULL;

CREATE INDEX idx_purchases_active ON finance.purchases (user_id, created_at)
  WHERE deleted_at IS NULL;

-- Note: Original non-partial indexes are retained for queries that may include soft-deleted rows.
-- Query planner will choose the appropriate index based on WHERE clause.
*/

// ============================================================================
// ROW LEVEL SECURITY (RLS) POLICY FRAMEWORK
// ============================================================================
/*
-- Enable RLS on user-scoped tables
ALTER TABLE auth.user_profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE learning.quiz_attempts ENABLE ROW LEVEL SECURITY;
ALTER TABLE finance.purchases ENABLE ROW LEVEL SECURITY;
-- offline tables removed (offline sync feature removed from MVP)

-- v2.1: RLS for new tables

-- User isolation policy (application sets app.current_user_id via SET LOCAL)
CREATE POLICY user_isolation ON auth.user_profiles
  USING (user_id = current_setting('app.current_user_id')::bigint);

CREATE POLICY user_isolation ON learning.quiz_attempts
  USING (user_id = current_setting('app.current_user_id')::bigint);

CREATE POLICY user_isolation ON finance.purchases
  USING (user_id = current_setting('app.current_user_id')::bigint);

-- Admin bypass policy
CREATE POLICY admin_bypass ON auth.user_profiles
  USING (current_setting('app.role') = 'admin');

-- Audit tables: INSERT only for application, SELECT for admins
ALTER TABLE ops.audit_logs ENABLE ROW LEVEL SECURITY;
CREATE POLICY audit_insert ON ops.audit_logs FOR INSERT WITH CHECK (true);
CREATE POLICY audit_select ON ops.audit_logs FOR SELECT USING (current_setting('app.role') IN ('admin', 'auditor'));

ALTER TABLE ops.security_events ENABLE ROW LEVEL SECURITY;
CREATE POLICY security_insert ON ops.security_events FOR INSERT WITH CHECK (true);
CREATE POLICY security_select ON ops.security_events FOR SELECT USING (current_setting('app.role') IN ('admin', 'auditor'));
*/