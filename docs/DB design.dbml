// ============================================================================
// Course Builder / LMS Platform — Production Database Schema
// Version: 4.0 (Bundle Mechanism + Education Levels Removed)
// Target: PostgreSQL 16
// Date: 2026-08-10
//
// CHANGES FROM v3.0:
// ─────────────────────────────────────────────────────────────────────────────
// [REMOVED] catalog.education_levels — table deleted entirely
// [REMOVED] catalog.exam_types.education_level_id — FK and column removed
// [ADDED]   catalog.course_bundles — bundling entity grouped by exam_type
// [ADDED]   catalog.bundle_courses — M:N junction (bundles ↔ courses)
// [MODIFIED] finance.purchase_options — supports bundles (course_id XOR bundle_id)
// [MODIFIED] finance.purchases — supports bundle purchases
// [MODIFIED] catalog.exam_types — standalone hierarchy (parent self-ref only)
// [ADDED]   finance.bundle_purchase_options — bundle-specific pricing
// [ADDED]   learning.bundle_enrollments — tracks bundle purchase → per-course enrollment
// ============================================================================

Project CourseBuilderLMS {
  database_type: 'PostgreSQL'
  Note: '''
    v4.0: Course Builder / LMS with bundle-based selling.
    Content hierarchy: Courses → Modules → Lessons.
    Bundles group courses by exam_type for packaged selling.
    RBAC: Course-scoped roles via ops.course_roles.
    Authentication: Telegram + Google OAuth (Better Auth).
    Payment: Telebirr-only. Ethiopia scope. Max 3 devices per user.
  '''
}

// ============================================================================
// ENUM DEFINITIONS
// ============================================================================

Enum account_status {
  pending_verification
  active
  locked
  suspended
  deleted
}

Enum platform {
  ios
  android
  web
}

Enum consent_type {
  essential
  analytics
  personalization
  marketing
  third_party_sharing
}

Enum education_segment {
  toefl
  igcse
  high_school
  college
}

Enum content_type {
  pdf
  video
  quiz
  exercise
  link
}

Enum content_license_type {
  perpetual
  subscription
  limited_use
  open_source
}

Enum content_license_status {
  active
  expiring_soon
  expired
  revoked
}

Enum license_grant_status {
  active
  expired
  revoked
}

Enum payment_provider {
  telebirr
}

Enum purchase_status {
  initiated
  payment_pending
  completed
  failed
}

Enum transaction_type {
  authorization
  capture
}

Enum transaction_status {
  pending
  succeeded
  failed
}

Enum enrollment_source {
  purchase
  bundle_purchase [note: 'Enrolled via bundle purchase']
  free_access
  admin_grant
  preview
}

Enum lesson_feedback_type {
  thumbs_up
  thumbs_down
}

Enum moderation_status {
  pending
  approved
  rejected
  edited
}

Enum audit_action {
  user_login
  user_logout
  purchase_completed
  lesson_access
  admin_action
  data_export
  permission_change
  content_moderation
  grade_modified
  enrollment_status_changed
  bundle_purchased [note: 'New: track bundle purchase events']
}

Enum security_event_type {
  failed_login
  account_lockout
  suspicious_ip
  token_reuse
  rate_limit_exceeded
  permission_denied
}

Enum severity_level {
  info
  warning
  critical
}

Enum flag_type {
  boolean
  percentage
  user_segment
  date_range
}

Enum job_status {
  pending
  processing
  completed
  failed
  retrying
}

Enum webhook_processing_status {
  received
  verified
  processed
  failed
}

Enum login_attempt_type {
  oauth_login
  token_refresh
}

Enum course_status {
  draft
  published
  archived
}

// [NEW] Bundle lifecycle status
Enum bundle_status {
  draft [note: 'Bundle being assembled']
  published [note: 'Bundle visible and purchasable']
  archived [note: 'Bundle no longer sold; existing enrollments retained']
}

Enum audit_resource_type {
  course
  module
  lesson
  enrollment
  quiz_attempt
  purchase
  user_account
  role_assignment
  bundle [note: 'New: audit bundle actions']
}

Enum moderation_content_type {
  course_review
  lesson_report
  student_report
  instructor_report
}

// ============================================================================
// SCHEMA: auth (Identity & Access)
// ============================================================================

Table auth.users {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  phone_number_encrypted bytea [note: 'AES-256-GCM encrypted. NULL for social-login users.']
  phone_number_hash varchar(64) [note: 'SHA-256 hash for lookups. NULL for social-login users.']
  phone_number_last4 char(4) [note: 'Last 4 digits for support. NULL for social-login users.']
  hash_version smallint [default: 1]
  device_count integer [not null, default: 0]
  max_devices integer [not null, default: 3]
  display_name varchar(100)
  account_status account_status [not null, default: 'active']
  failed_login_attempts smallint [not null, default: 0, check: `failed_login_attempts >= 0`]
  locked_until timestamptz
  last_login_at timestamptz
  last_active_at timestamptz
  deletion_requested_at timestamptz
  deletion_completed_at timestamptz
  retention_expires_at timestamptz [note: 'When PII columns must be purged (GDPR)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Central identity table. Roles managed via ops.course_roles (course-scoped RBAC).'
  Indexes {
    (public_id) [unique, name: "idx_users_public_id"]
    (phone_number_hash) [unique, name: "idx_users_phone_hash"]
    (account_status) [name: "idx_users_status"]
    (deleted_at) [name: "idx_users_deleted"]
    (deletion_requested_at) [name: "idx_users_deletion_sla"]
    (retention_expires_at) [name: "idx_users_retention"]
  }
}

Table auth.user_profiles {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  avatar_object_key varchar(500)
  email_encrypted bytea [note: 'AES-256-GCM encrypted email']
  email_hash varchar(64) [note: 'SHA-256 hash of lowercase email for lookups']
  education_segment education_segment
  notification_preferences jsonb [not null, default: '{}']
  language_preference varchar(10) [not null, default: 'en']
  timezone varchar(50) [not null, default: 'Africa/Addis_Ababa']
  exam_preferences jsonb [not null, default: '[]']
  is_onboarding_completed boolean [not null, default: false]
  onboarding_step smallint [not null, default: 0, check: `onboarding_step >= 0 AND onboarding_step <= 5`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'One-to-one profile extension. Email encrypted at rest.'
  Indexes {
    (public_id) [unique, name: "idx_user_profiles_public"]
    (user_id) [unique, name: "idx_user_profiles_user"]
    (email_hash) [unique, name: "idx_user_profiles_email_hash"]
  }
}

Table auth.devices {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  device_identifier varchar(255) [not null]
  device_name varchar(100)
  platform platform
  os_version varchar(50)
  app_version varchar(20)
  last_active_at timestamptz [not null, default: `now()`]
  registered_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true]
  deleted_at timestamptz
  Note: 'Max 3 active devices per user.'
  Indexes {
    (public_id) [unique, name: "idx_devices_public"]
    (user_id, device_identifier) [unique, name: "idx_devices_user_identifier"]
    (user_id, last_active_at) [name: "idx_devices_user_active"]
  }
}

Table auth.user_consents {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  consent_type consent_type [not null]
  consent_version varchar(20) [not null]
  is_granted boolean [not null]
  ip_address inet
  consented_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Immutable consent audit trail.'
  Indexes {
    (public_id) [unique, name: "idx_consents_public"]
    (user_id, consent_type, consent_version) [unique, name: "idx_consents_unique"]
    (user_id) [name: "idx_consents_user"]
  }
}

Table auth.login_attempts {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  phone_number_last4 char(4) [not null]
  ip_address inet [not null]
  user_agent varchar(500)
  attempt_type login_attempt_type [not null]
  is_successful boolean [not null]
  failure_reason varchar(100)
  attempted_at timestamptz [not null, default: `now()`]
  retention_expires_at timestamptz [not null, note: 'attempted_at + 2 years']
  created_at timestamptz [not null, default: `now()`]
  Note: 'Append-only security audit. Partitioned monthly.'
  Indexes {
    (public_id) [unique, name: "idx_login_attempts_public"]
    (phone_number_last4, attempted_at) [name: "idx_login_attempts_phone_time"]
    (ip_address, attempted_at) [name: "idx_login_attempts_ip_time"]
    (attempted_at) [name: "idx_login_attempts_time"]
    (retention_expires_at) [name: "idx_login_attempts_retention"]
  }
}

// ============================================================================
// SCHEMA: catalog (Course Content + Bundles)
// ============================================================================
// [REMOVED] catalog.education_levels — DELETED.
// exam_types is now a standalone self-referencing hierarchy.
// ============================================================================

Table catalog.exam_types {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  // [REMOVED] education_level_id — no longer references education_levels
  name varchar(100) [not null]
  slug varchar(100) [not null]
  description text
  parent_exam_type_id bigint [note: 'Self-referencing hierarchy. NULL = top-level exam type.']
  depth smallint [not null, default: 0, check: `depth >= 0`, note: '0=top-level, 1=child, etc.']
  sort_order smallint [not null, default: 0, check: `sort_order >= 0`]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: '''
    Standalone exam type hierarchy (no education_levels parent).
    Self-referencing via parent_exam_type_id for sub-categories.
    Examples: TOEFL → (Reading, Listening, Speaking, Writing)
              IGCSE → (Mathematics, Physics, Chemistry)
  '''
  Indexes {
    (public_id) [unique, name: "idx_exam_types_public"]
    (slug) [unique, name: "idx_exam_types_slug"]
    (parent_exam_type_id, sort_order) [name: "idx_exam_types_parent_order"]
    (is_active, sort_order) [name: "idx_exam_types_active_order"]
  }
}

// ============================================================================
// COURSE BUILDER HIERARCHY: courses → modules → lessons
// ============================================================================

Table catalog.courses {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  exam_type_id bigint [not null]
  instructor_id bigint [note: 'FK to auth.users.id. Course owner/creator.']
  title varchar(300) [not null]
  slug varchar(200) [not null]
  description text
  thumbnail_object_key varchar(500)
  price_amount numeric(19, 4) [check: `price_amount IS NULL OR price_amount >= 0`]
  price_currency char(3) [not null, default: 'ETB', check: `price_currency ~ '^[A-Z]{3}$'`]
  is_free boolean [not null, default: false]
  status course_status [not null, default: 'draft']
  published_at timestamptz
  version integer [not null, default: 1, check: `version >= 1`]
  row_version integer [not null, default: 1, note: 'Optimistic lock version']
  sort_order smallint [not null, default: 0, check: `sort_order >= 0`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Top-level content entity. Owned by instructor. Status: draft → published → archived.'
  Indexes {
    (public_id) [unique, name: "idx_courses_public"]
    (exam_type_id, status, sort_order) [name: "idx_courses_list_query"]
    (slug) [unique, name: "idx_courses_slug"]
    (instructor_id) [name: "idx_courses_instructor"]
    (status, is_free) [name: "idx_courses_discovery"]
    (exam_type_id, status, sort_order) [name: "idx_courses_active_list", note: 'Partial: WHERE deleted_at IS NULL']
  }
}

Table catalog.course_stats {
  course_id bigint [pk]
  total_enrollments integer [not null, default: 0, check: `total_enrollments >= 0`]
  active_students_7d integer [not null, default: 0, check: `active_students_7d >= 0`]
  downloads_30d integer [not null, default: 0, check: `downloads_30d >= 0`]
  purchase_count integer [not null, default: 0, check: `purchase_count >= 0`]
  average_rating numeric(3, 2) [check: `average_rating IS NULL OR (average_rating >= 1.0 AND average_rating <= 5.0)`]
  rating_count integer [not null, default: 0, check: `rating_count >= 0`]
  weighted_rating numeric(4, 3)
  popularity_score numeric(10, 4)
  calculated_at timestamptz [not null, default: `now()`]
  Note: 'Materialized metrics. One row per course. Recalculated daily.'
  Indexes {
    (popularity_score, weighted_rating) [name: "idx_course_stats_recommendation", note: 'Single covering index']
  }
}

Table catalog.course_stats_history {
  id bigint [pk, increment]
  course_id bigint [not null]
  snapshot_date date [not null]
  total_enrollments integer [not null, default: 0]
  active_students_7d integer [not null, default: 0]
  downloads_30d integer [not null, default: 0]
  purchase_count integer [not null, default: 0]
  average_rating numeric(3, 2)
  popularity_score numeric(10, 4)
  created_at timestamptz [not null, default: `now()`]
  Note: 'Daily snapshots for trend analysis. Partitioned monthly.'
  Indexes {
    (course_id, snapshot_date) [unique, name: "idx_stats_history_course_date"]
    (snapshot_date) [name: "idx_stats_history_date"]
  }
}

Table catalog.modules {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  course_id bigint [not null]
  instructor_id bigint [note: 'Module author.']
  title varchar(300) [not null]
  description text
  sort_order smallint [not null, check: `sort_order >= 0`]
  estimated_duration_minutes integer [check: `estimated_duration_minutes IS NULL OR estimated_duration_minutes > 0`]
  is_preview_available boolean [not null, default: false]
  row_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Second level in hierarchy. DELETE from parent course is RESTRICT.'
  Indexes {
    (public_id) [unique, name: "idx_modules_public"]
    (course_id, sort_order) [unique, name: "idx_modules_course_order"]
    (course_id) [name: "idx_modules_course"]
    (instructor_id) [name: "idx_modules_instructor"]
    (course_id, sort_order) [name: "idx_modules_course_active", note: 'Partial: WHERE deleted_at IS NULL']
  }
}

Table catalog.lessons {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  module_id bigint [not null]
  course_id bigint [not null, note: 'Denormalized from modules.course_id via trigger.']
  instructor_id bigint [note: 'Lesson author.']
  title varchar(300) [not null]
  description text
  content_type content_type [not null]
  file_object_key varchar(500)
  file_size_bytes bigint [check: `file_size_bytes IS NULL OR file_size_bytes >= 0`]
  mime_type varchar(100)
  duration_seconds integer [check: `duration_seconds IS NULL OR duration_seconds >= 0`]
  page_count smallint [check: `page_count IS NULL OR page_count > 0`]
  is_downloadable boolean [not null, default: true]
  download_size_limit_bytes bigint [not null, default: 524288000, check: `download_size_limit_bytes >= 0`]
  search_vector tsvector
  row_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Third level in hierarchy. No version tracking — updated in place.'
  Indexes {
    (public_id) [unique, name: "idx_lessons_public"]
    (module_id) [name: "idx_lessons_module"]
    (course_id) [name: "idx_lessons_course"]
    (content_type) [name: "idx_lessons_content_type"]
    (instructor_id) [name: "idx_lessons_instructor"]
    (search_vector) [type: gin, name: "idx_lessons_search"]
    (course_id, content_type) [name: "idx_lessons_course_type"]
    (module_id) [name: "idx_lessons_module_active", note: 'Partial: WHERE deleted_at IS NULL']
  }
}

// ============================================================================
// COURSE TAGS (tags apply only to courses)
// ============================================================================

Table catalog.course_tags {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  name varchar(100) [not null]
  slug varchar(100) [not null]
  description text
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_course_tags_public"]
    (slug) [unique, name: "idx_course_tags_slug"]
  }
}

Table catalog.course_tag_assignments {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  course_id bigint [not null]
  tag_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (public_id) [unique, name: "idx_course_tag_assignments_public"]
    (course_id, tag_id) [unique, name: "idx_course_tag_assignments_unique"]
    (tag_id) [name: "idx_course_tag_assignments_tag"]
    (course_id) [name: "idx_course_tag_assignments_course"]
  }
}

// ============================================================================
// [NEW] COURSE BUNDLES — Grouping courses by exam_type for packaged selling
// ============================================================================

Table catalog.course_bundles {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  exam_type_id bigint [not null, note: 'Bundles are themed around an exam_type. All courses in the bundle should belong to this exam_type (enforced via trigger).']
  instructor_id bigint [note: 'Bundle creator. FK to auth.users.id.']
  title varchar(300) [not null]
  slug varchar(200) [not null]
  description text
  thumbnail_object_key varchar(500)
  // Bundle pricing — the discounted package price
  price_amount numeric(19, 4) [not null, check: `price_amount >= 0`, note: 'Bundle price. Must be less than sum of individual course prices (enforced via trigger).']
  price_currency char(3) [not null, default: 'ETB', check: `price_currency ~ '^[A-Z]{3}$'`]
  // Original combined price (for showing discount to students)
  original_price_amount numeric(19, 4) [not null, check: `original_price_amount >= 0`, note: 'Sum of individual course prices. For displaying "Save X%" to students.']
  discount_percentage numeric(5, 2) [not null, default: 0, check: `discount_percentage >= 0 AND discount_percentage <= 100`, note: 'Calculated: ((original - bundle) / original) * 100']
  status bundle_status [not null, default: 'draft']
  published_at timestamptz
  row_version integer [not null, default: 1]
  sort_order smallint [not null, default: 0, check: `sort_order >= 0`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: '''
    [NEW] Bundles group courses by exam_type for packaged selling.
    A bundle is themed around an exam_type (e.g., "Complete TOEFL Prep Bundle").
    Contains curated courses via bundle_courses junction table.
    Priced at a discount vs buying courses individually.
    Status lifecycle: draft → published → archived.
    When a student purchases a bundle, they receive enrollments in ALL courses within it.
  '''
  Indexes {
    (public_id) [unique, name: "idx_course_bundles_public"]
    (exam_type_id, status, sort_order) [name: "idx_bundles_exam_status"]
    (slug) [unique, name: "idx_bundles_slug"]
    (instructor_id) [name: "idx_bundles_instructor"]
    (status) [name: "idx_bundles_status"]
    (exam_type_id, status) [name: "idx_bundles_active", note: 'Partial: WHERE deleted_at IS NULL']
  }
}

Table catalog.bundle_courses {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  bundle_id bigint [not null]
  course_id bigint [not null]
  sort_order smallint [not null, default: 0, check: `sort_order >= 0`, note: 'Display order within the bundle']
  is_included boolean [not null, default: true, note: 'Allows temporarily removing a course from bundle without deleting the row']
  added_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  Note: '''
    [NEW] M:N junction: bundles ↔ courses.
    A course can appear in multiple bundles (e.g., "TOEFL Reading" in both
    "Complete TOEFL Bundle" and "TOEFL Reading + Writing Bundle").
    is_included allows soft-exclusion without breaking purchase history.
    Trigger validates: course.exam_type_id = bundle.exam_type_id.
  '''
  Indexes {
    (public_id) [unique, name: "idx_bundle_courses_public"]
    (bundle_id, course_id) [unique, name: "idx_bundle_courses_unique"]
    (bundle_id, is_included, sort_order) [name: "idx_bundle_courses_active"]
    (course_id) [name: "idx_bundle_courses_course"]
  }
}

// ============================================================================
// SCHEMA: finance (Payments & Licensing)
// ============================================================================

Table finance.content_licenses {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  lesson_id bigint [not null]
  license_type content_license_type [not null]
  license_terms text
  start_date timestamptz [not null]
  end_date timestamptz [check: `end_date IS NULL OR end_date >= start_date`]
  auto_renewal boolean [not null, default: false]
  renewal_reminder_days integer [not null, default: 30, check: `renewal_reminder_days >= 0 AND renewal_reminder_days <= 365`]
  status content_license_status [not null, default: 'active']
  grace_period_days integer [not null, default: 90, check: `grace_period_days >= 0 AND grace_period_days <= 365`]
  licensor_name varchar(200)
  licensor_contact varchar(300)
  cost_amount numeric(19, 4) [check: `cost_amount IS NULL OR cost_amount >= 0`]
  cost_currency char(3) [not null, default: 'ETB', check: `cost_currency ~ '^[A-Z]{3}$'`]
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_content_licenses_public"]
    (lesson_id, status) [name: "idx_content_licenses_lesson_status"]
    (end_date, status) [name: "idx_content_licenses_expiry_monitor"]
  }
}

Table finance.content_license_grants {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  content_license_id bigint [not null]
  student_id bigint [not null]
  purchase_id bigint
  granted_at timestamptz [not null, default: `now()`]
  access_expires_at timestamptz [not null]
  status license_grant_status [not null, default: 'active']
  revoked_at timestamptz
  revoke_reason varchar(200)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes {
    (public_id) [unique, name: "idx_content_license_grants_public"]
    (student_id, status) [name: "idx_clg_student_status"]
    (content_license_id, status) [name: "idx_clg_license_status"]
    (access_expires_at) [name: "idx_clg_expiry"]
    (purchase_id) [name: "idx_clg_purchase"]
    (status, access_expires_at) [name: "idx_clg_active_expiring", note: 'Partial: WHERE status = active']
  }
}

Table finance.payment_gateways {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  provider_name payment_provider [not null]
  display_name varchar(100) [not null]
  is_enabled boolean [not null, default: true]
  requires_disclosure boolean [not null, default: false]
  disclosure_text text
  api_config jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_payment_gateways_public"]
    (provider_name) [unique, name: "idx_payment_gateways_provider"]
    (is_enabled) [name: "idx_payment_gateways_enabled"]
  }
}

// [MODIFIED] purchase_options now supports both courses and bundles
Table finance.purchase_options {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  // [MODIFIED] course_id is now nullable — exactly one of course_id or bundle_id must be set
  course_id bigint [note: '[MODIFIED] Nullable. XOR with bundle_id.']
  bundle_id bigint [note: '[NEW] Nullable. XOR with course_id. References catalog.course_bundles.id.']
  payment_gateway_id bigint [not null]
  platform platform [not null]
  product_id varchar(255) [not null]
  display_name varchar(150) [not null]
  description text
  duration_days integer [not null, check: `duration_days > 0`]
  price_amount numeric(19, 4) [not null, check: `price_amount >= 0`]
  price_currency char(3) [not null, default: 'ETB', check: `price_currency ~ '^[A-Z]{3}$'`]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: '''
    [MODIFIED] Supports both individual course pricing and bundle pricing.
    CHECK constraint ensures exactly one of course_id or bundle_id is non-null.
    For bundles: price_amount is the bundle price (discounted).
    For courses: price_amount is the individual course price.
  '''
  Indexes {
    (public_id) [unique, name: "idx_purchase_options_public"]
    (course_id, platform, is_active) [name: "idx_purchase_options_course"]
    (bundle_id, platform, is_active) [name: "idx_purchase_options_bundle"]
    (payment_gateway_id) [name: "idx_purchase_options_gateway"]
  }
}

// [MODIFIED] purchases now supports bundle purchases
Table finance.purchases {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  student_id bigint [not null]
  // [MODIFIED] course_id is now nullable — exactly one of course_id or bundle_id
  course_id bigint [note: '[MODIFIED] Nullable. Set for individual course purchases.']
  bundle_id bigint [note: '[NEW] Nullable. Set for bundle purchases.']
  purchase_option_id bigint [not null]
  payment_gateway_id bigint [not null]
  status purchase_status [not null, default: 'initiated']
  amount numeric(19, 4) [not null, check: `amount >= 0`]
  currency char(3) [not null, default: 'ETB', check: `currency ~ '^[A-Z]{3}$'`]
  receipt_object_key varchar(500)
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: '''
    [MODIFIED] Supports both individual course and bundle purchases.
    CHECK: exactly one of course_id or bundle_id is non-null.
    When a bundle is purchased, application creates enrollments for each course in the bundle.
    Telebirr-only. No refunds.
  '''
  Indexes {
    (public_id) [unique, name: "idx_purchases_public"]
    (student_id, created_at) [name: "idx_purchases_student_time"]
    (course_id) [name: "idx_purchases_course"]
    (bundle_id) [name: "idx_purchases_bundle"]
    (purchase_option_id) [name: "idx_purchases_option"]
    (status) [name: "idx_purchases_status"]
    (student_id, course_id) [name: "idx_purchases_student_course"]
    (student_id, bundle_id) [name: "idx_purchases_student_bundle"]
    (status, created_at) [name: "idx_purchases_status_time"]
  }
}

Table finance.purchase_transactions {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  purchase_id bigint [not null]
  transaction_type transaction_type [not null]
  external_transaction_id varchar(255)
  amount numeric(19, 4) [not null, check: `amount >= 0`]
  currency char(3) [not null, default: 'ETB', check: `currency ~ '^[A-Z]{3}$'`]
  status transaction_status [not null, default: 'pending']
  validation_response jsonb
  error_message text
  idempotency_key varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Immutable transaction log.'
  Indexes {
    (public_id) [unique, name: "idx_purchase_transactions_public"]
    (purchase_id) [name: "idx_purchase_transactions_purchase"]
    (external_transaction_id) [name: "idx_purchase_transactions_external"]
    (idempotency_key) [unique, name: "idx_purchase_transactions_idempotent"]
    (status, created_at) [name: "idx_purchase_transactions_pending"]
  }
}

// ============================================================================
// SCHEMA: learning (Enrollment, Progress & Assessment)
// ============================================================================

Table learning.enrollments {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  student_id bigint [not null]
  course_id bigint [not null]
  purchase_id bigint
  bundle_id bigint [note: '[NEW] Set when enrollment was created from a bundle purchase.']
  enrollment_source enrollment_source [not null, default: 'purchase']
  progress_percentage numeric(5, 2) [not null, default: 0, check: `progress_percentage >= 0 AND progress_percentage <= 100`]
  is_completed boolean [not null, default: false]
  completed_at timestamptz
  last_accessed_at timestamptz
  row_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: '''
    Student registration in a course with progress tracking.
    [NEW] bundle_id tracks which bundle triggered this enrollment (if any).
    enrollment_source = 'bundle_purchase' when created from a bundle.
    CHECK: enrollment_source='purchase' requires purchase_id.
    CHECK: enrollment_source='bundle_purchase' requires bundle_id AND purchase_id.
  '''
  Indexes {
    (public_id) [unique, name: "idx_enrollments_public"]
    (student_id, course_id) [unique, name: "idx_enrollments_unique"]
    (student_id, last_accessed_at) [name: "idx_enrollments_student_recent"]
    (course_id, is_completed) [name: "idx_enrollments_course_completion"]
    (purchase_id) [name: "idx_enrollments_purchase"]
    (bundle_id) [name: "idx_enrollments_bundle"]
    (student_id, last_accessed_at) [name: "idx_enrollments_active", note: 'Partial: WHERE deleted_at IS NULL']
  }
}

Table learning.lesson_completions {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  student_id bigint [not null]
  lesson_id bigint [not null]
  enrollment_id bigint [not null]
  is_completed boolean [not null, default: false]
  completed_at timestamptz
  time_spent_seconds integer [check: `time_spent_seconds IS NULL OR time_spent_seconds >= 0`]
  row_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Granular progress tracking per lesson. Partitioned monthly.'
  Indexes {
    (public_id) [unique, name: "idx_lesson_completions_public"]
    (student_id, lesson_id) [unique, name: "idx_lesson_completions_unique"]
    (enrollment_id) [name: "idx_lesson_completions_enrollment"]
    (lesson_id) [name: "idx_lesson_completions_lesson"]
    (enrollment_id, is_completed) [name: "idx_lesson_completions_progress"]
    (enrollment_id, is_completed) [name: "idx_lesson_completions_incomplete", note: 'Partial: WHERE is_completed = false']
  }
}

Table learning.quiz_questions {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  lesson_id bigint [not null, note: 'Must reference lesson with content_type=quiz. Enforced via trigger.']
  question_index smallint [not null, check: `question_index >= 0`]
  question_text text [not null]
  correct_answer text [not null]
  explanation text
  row_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_quiz_questions_public"]
    (lesson_id, question_index) [unique, name: "idx_quiz_questions_unique"]
    (lesson_id) [name: "idx_quiz_questions_lesson"]
  }
}

Table learning.quiz_attempts {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  student_id bigint [not null]
  lesson_id bigint [not null]
  attempt_number smallint [not null, check: `attempt_number >= 1`]
  total_questions smallint [not null, check: `total_questions > 0`]
  correct_answers smallint [not null, check: `correct_answers >= 0 AND correct_answers <= total_questions`]
  quiz_score_percentage numeric(5, 2) [not null, check: `quiz_score_percentage >= 0 AND quiz_score_percentage <= 100`]
  is_passed boolean [not null]
  duration_seconds integer [check: `duration_seconds IS NULL OR duration_seconds >= 0`]
  started_at timestamptz [not null]
  completed_at timestamptz
  row_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Partitioned monthly by started_at.'
  Indexes {
    (public_id) [unique, name: "idx_quiz_attempts_public"]
    (student_id, lesson_id) [name: "idx_quiz_attempts_student_lesson"]
    (student_id, created_at) [name: "idx_quiz_attempts_student_time"]
    (lesson_id, is_passed) [name: "idx_quiz_attempts_lesson_pass"]
    (student_id, lesson_id, completed_at) [name: "idx_quiz_attempts_history"]
  }
}

Table learning.quiz_answers {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  quiz_attempt_id bigint [not null]
  question_id bigint [not null]
  student_answer text
  is_correct boolean [not null]
  answered_at timestamptz [not null]
  row_version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Grade modifications logged to quiz_answer_history via trigger.'
  Indexes {
    (public_id) [unique, name: "idx_quiz_answers_public"]
    (quiz_attempt_id, question_id) [unique, name: "idx_quiz_answers_unique"]
    (quiz_attempt_id) [name: "idx_quiz_answers_attempt"]
    (question_id) [name: "idx_quiz_answers_question"]
  }
}

Table learning.quiz_answer_history {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  quiz_answer_id bigint [not null]
  old_is_correct boolean
  new_is_correct boolean
  old_student_answer text
  new_student_answer text
  changed_by bigint [not null]
  change_reason varchar(200)
  changed_at timestamptz [not null, default: `now()`]
  Note: 'Immutable grade audit trail. Append-only.'
  Indexes {
    (public_id) [unique, name: "idx_quiz_answer_history_public"]
    (quiz_answer_id, changed_at) [name: "idx_qah_answer_time"]
    (changed_by, changed_at) [name: "idx_qah_changed_by"]
    (changed_at) [name: "idx_qah_time"]
  }
}

Table learning.course_reviews {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  student_id bigint [not null]
  course_id bigint [not null]
  rating smallint [not null, check: `rating >= 1 AND rating <= 5`]
  title varchar(200) [not null]
  content text [not null]
  moderation_status moderation_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_course_reviews_public"]
    (course_id, rating) [name: "idx_course_reviews_course_rating"]
    (student_id, course_id) [unique, name: "idx_course_reviews_student_course"]
    (moderation_status, created_at) [name: "idx_course_reviews_status_time"]
  }
}

// ============================================================================
// SCHEMA: ops (Operations, Security & Admin)
// ============================================================================

Table ops.audit_logs {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  actor_id bigint
  actor_ip inet
  action audit_action [not null]
  resource_type audit_resource_type [not null]
  course_id bigint
  module_id bigint
  lesson_id bigint
  enrollment_id bigint
  quiz_attempt_id bigint
  purchase_id bigint
  bundle_id bigint [note: '[NEW] For bundle-related audit events']
  old_values jsonb
  new_values jsonb
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  Note: 'Immutable audit trail with typed FKs. Partitioned monthly.'
  Indexes {
    (public_id) [unique, name: "idx_audit_logs_public"]
    (actor_id, created_at) [name: "idx_audit_logs_actor_time"]
    (action, created_at) [name: "idx_audit_logs_action_time"]
    (resource_type, course_id) [name: "idx_audit_logs_course"]
    (resource_type, bundle_id) [name: "idx_audit_logs_bundle"]
    (created_at) [name: "idx_audit_logs_time"]
  }
}

Table ops.principals {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  principal_type varchar(20) [not null, check: `principal_type IN ('user', 'service', 'integration')`]
  user_id bigint
  service_name varchar(100)
  integration_name varchar(100)
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_principals_public"]
    (principal_type) [name: "idx_principals_type"]
    (user_id) [unique, name: "idx_principals_user"]
    (service_name) [unique, name: "idx_principals_service"]
    (integration_name) [unique, name: "idx_principals_integration"]
  }
}

Table ops.roles {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  name varchar(50) [not null]
  description text
  permissions jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_roles_public"]
    (name) [unique, name: "idx_roles_name"]
  }
}

Table ops.course_roles {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  user_id bigint [not null]
  course_id bigint [note: 'NULL = global role. Non-null = course-scoped role.']
  role_id bigint [not null]
  granted_by bigint
  granted_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Course-scoped RBAC. A user can be instructor for Course A and student in Course B.'
  Indexes {
    (public_id) [unique, name: "idx_course_roles_public"]
    (user_id, course_id, role_id) [unique, name: "idx_course_roles_unique"]
    (course_id, role_id) [name: "idx_course_roles_course_role"]
    (role_id) [name: "idx_course_roles_role"]
    (user_id) [name: "idx_course_roles_user"]
  }
}

Table ops.permissions_reference {
  permission_key varchar(100) [pk]
  description text
  resource_scope varchar(50)
  is_deprecated boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (resource_scope) [name: "idx_permissions_reference_scope"]
  }
}

Table ops.security_events {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  event_type security_event_type [not null]
  actor_id bigint
  actor_ip inet
  severity severity_level [not null, default: 'info']
  description text [not null]
  metadata jsonb [not null, default: '{}']
  retention_expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Immutable security log. Partitioned monthly.'
  Indexes {
    (public_id) [unique, name: "idx_security_events_public"]
    (event_type, created_at) [name: "idx_security_events_type_time"]
    (severity, created_at) [name: "idx_security_events_severity_time"]
    (created_at) [name: "idx_security_events_time"]
    (retention_expires_at) [name: "idx_security_events_retention"]
  }
}

Table ops.feature_flags {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  flag_key varchar(100) [not null]
  description text
  flag_type flag_type [not null]
  is_enabled boolean [not null, default: false]
  rollout_percentage smallint
  target_segments jsonb
  start_date timestamptz
  end_date timestamptz [check: `end_date IS NULL OR end_date > start_date`]
  created_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_feature_flags_public"]
    (flag_key) [unique, name: "idx_feature_flags_key"]
    (is_enabled, flag_type) [name: "idx_feature_flags_filter"]
  }
}

Table ops.system_configs {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  config_key varchar(100) [not null]
  config_value jsonb [not null]
  description text
  is_sensitive boolean [not null, default: false]
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_system_configs_public"]
    (config_key) [unique, name: "idx_system_configs_key"]
  }
}

Table ops.outbox_events {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  aggregate_type varchar(100) [not null]
  aggregate_id uuid [not null]
  event_type varchar(200) [not null]
  event_data jsonb [not null]
  metadata jsonb [not null, default: '{}']
  is_published boolean [not null, default: false]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Transactional outbox. Partitioned daily.'
  Indexes {
    (public_id) [unique, name: "idx_outbox_events_public"]
    (is_published, created_at) [name: "idx_outbox_events_publisher_poll"]
    (aggregate_type, aggregate_id) [name: "idx_outbox_events_aggregate"]
    (created_at) [name: "idx_outbox_events_time"]
  }
}

Table ops.webhook_events {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  provider payment_provider [not null]
  event_type varchar(100) [not null]
  raw_payload jsonb [not null]
  signature_header varchar(500)
  is_verified boolean [not null, default: false]
  processing_status webhook_processing_status [not null, default: 'received']
  error_message text
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  Note: 'Immutable webhook log. Partitioned monthly.'
  Indexes {
    (public_id) [unique, name: "idx_webhook_events_public"]
    (processing_status, received_at) [name: "idx_webhook_events_processing"]
    (provider, event_type) [name: "idx_webhook_events_provider_type"]
    (received_at) [name: "idx_webhook_events_time"]
  }
}

Table ops.api_keys {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  principal_id bigint [not null]
  key_hash varchar(255) [not null]
  key_hash_salt bytea [not null]
  key_prefix varchar(10) [not null]
  permissions jsonb [not null, default: '[]']
  is_active boolean [not null, default: true]
  last_used_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_api_keys_public"]
    (key_hash) [unique, name: "idx_api_keys_hash"]
    (principal_id) [name: "idx_api_keys_principal"]
    (is_active, expires_at) [name: "idx_api_keys_active"]
  }
}

Table ops.job_queue {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  job_type varchar(100) [not null]
  job_data jsonb [not null]
  status job_status [not null, default: 'pending']
  priority smallint [not null, default: 0, check: `priority >= 0 AND priority <= 10`]
  scheduled_at timestamptz
  max_retries smallint [not null, default: 3, check: `max_retries >= 0 AND max_retries <= 10`]
  retry_count smallint [not null, default: 0, check: `retry_count >= 0 AND retry_count <= max_retries`]
  retry_backoff_seconds integer [not null, default: 60, check: `retry_backoff_seconds > 0`]
  last_error text
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'Job queue. Partitioned monthly.'
  Indexes {
    (public_id) [unique, name: "idx_job_queue_public"]
    (status, priority, scheduled_at) [name: "idx_job_queue_worker_poll"]
    (job_type, status) [name: "idx_job_queue_type_status"]
    (scheduled_at) [name: "idx_job_queue_scheduled"]
  }
}

Table ops.moderation_queue {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  content_type moderation_content_type [not null]
  content_id bigint [not null]
  status moderation_status [not null, default: 'pending']
  submitted_by bigint
  assigned_to bigint
  priority smallint [not null, default: 0, check: `priority >= 0 AND priority <= 10`]
  submitted_at timestamptz [not null, default: `now()`]
  sla_deadline_at timestamptz [not null]
  resolved_at timestamptz
  resolution_note text
  auto_flagged_reasons jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes {
    (public_id) [unique, name: "idx_moderation_queue_public"]
    (status, priority, sla_deadline_at) [name: "idx_moderation_queue_worker"]
    (assigned_to, status) [name: "idx_moderation_queue_assignee"]
    (submitted_by) [name: "idx_moderation_queue_submitter"]
    (sla_deadline_at) [name: "idx_moderation_queue_sla"]
  }
}

// ============================================================================
// SCHEMA: shared (File Storage)
// ============================================================================

Table shared.file_metadata {
  id bigint [pk, increment]
  public_id uuid [not null, default: `uuid_generate_v7()`, unique]
  object_key varchar(500) [not null]
  bucket_name varchar(100) [not null]
  original_filename varchar(500)
  mime_type varchar(100)
  file_size_bytes bigint [check: `file_size_bytes >= 0`]
  checksum_sha256 varchar(64)
  encryption_key_reference varchar(500)
  is_public boolean [not null, default: false]
  lesson_id bigint [note: 'FK to catalog.lessons.id. Direct ownership link.']
  uploaded_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes {
    (public_id) [unique, name: "idx_file_metadata_public"]
    (object_key) [unique, name: "idx_file_metadata_object_key"]
    (bucket_name) [name: "idx_file_metadata_bucket"]
    (uploaded_by, created_at) [name: "idx_file_metadata_uploader_time"]
    (lesson_id) [name: "idx_file_metadata_lesson"]
  }
}

