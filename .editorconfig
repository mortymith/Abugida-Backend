# EditorConfig: https://editorconfig.org
# Ensures consistent whitespace and encoding across editors/IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = lf