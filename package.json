{
  "name": "abugida-backend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "bun": ">=1.4.4"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.4",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:tui": "turbo dev --ui=tui",
    "build": "turbo build",
    "lint": "turbo lint && pnpm lint:tooling",
    "lint:tooling": "eslint --config tooling/eslint.config.js tooling commitlint.config.js knip.config.js lint-staged.config.js syncpack.config.js",
    "format": "turbo format && pnpm format:root && pnpm format:shell",
    "format:check": "turbo format:check && pnpm format:check:root && pnpm format:check:shell",
    "format:root": "prettier --config tooling/prettier-config/index.js --write \"*.{js,mjs,cjs,ts,tsx,json,yaml,yml}\" \"docs/**/*.{md,mdx,json,yaml,yml}\" \"tooling/**/*.{js,mjs,cjs,ts,tsx,json,md,mdx,yaml,yml}\"",
    "format:check:root": "prettier --config tooling/prettier-config/index.js --check \"*.{js,mjs,cjs,ts,tsx,json,yaml,yml}\" \"docs/**/*.{md,mdx,json,yaml,yml}\" \"tooling/**/*.{js,mjs,cjs,ts,tsx,json,md,mdx,yaml,yml}\"",
    "format:shell": "git ls-files '*.sh' | xargs -r shfmt -w -i 2 -sr -ln bash",
    "format:check:shell": "git ls-files '*.sh' | xargs -r shfmt -d -i 2 -sr -ln bash",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "clean:workspaces": "turbo clean",
    "prepare": "husky && turbo run build --filter=./packages/*",
    "lint:spelling": "cspell lint --config tooling/cspell-config/cspell.json --no-progress --no-summary \"**/*.md\"",
    "lint:docker": "git ls-files '*Dockerfile' | xargs -r hadolint -c .hadolint.yaml",
    "lint:yaml": "git ls-files '*.yml' '*.yaml' | grep -v pnpm-lock.yaml | xargs -r yamllint -c .yamllint.yaml",
    "lint:markdown": "git ls-files '*.md' | grep -v '^.agents' | xargs -r markdownlint -c .markdownlint.json",
    "lint:editorconfig": "editorconfig-checker -config .ecrc.json",
    "lint:env": "dotenv-linter --skip KeyShouldBeFormatted --skip QuoteCharacterMismatch --skip UnorderedKey .env.example app/api/.env.example app/dashboard/.env.example app/marketing/.env.example",
    "lint:shell": "git ls-files '*.sh' | xargs -r shellcheck -x --rcfile .shellcheckrc",
    "lint:secrets": "gitleaks git --no-banner --config .gitleaks.toml",
    "lint:deps": "syncpack lint",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip --no-progress"
  },
  "type": "module",
  "devDependencies": {
    "@abugida/bun-test-config": "workspace:*",
    "@abugida/cspell-config": "workspace:*",
    "@abugida/eslint-config": "workspace:*",
    "@abugida/prettier-config": "workspace:*",
    "@abugida/typescript-config": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
