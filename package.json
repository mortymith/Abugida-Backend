{
  "name": "abugida-backend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "bun": ">=1.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.4.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:tui": "turbo dev --ui=tui",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "clean:workspaces": "turbo clean",
    "prepare": "husky && turbo run build --filter=./packages/*",
    "lint:spelling": "cspell lint --no-progress --no-summary \"**/*.md\"",
    "lint:docker": "git ls-files '*Dockerfile' | xargs -r hadolint -c .hadolint.yaml",
    "lint:yaml": "git ls-files '*.yml' '*.yaml' | grep -v pnpm-lock.yaml | xargs -r yamllint -c .yamllint.yaml",
    "lint:markdown": "git ls-files '*.md' | grep -v '^.agents' | xargs -r markdownlint -c .markdownlint.json",
    "lint:editorconfig": "editorconfig-checker -config .ecrc.json",
    "lint:env": "dotenv-linter --skip KeyShouldBeFormatted --skip QuoteCharacterMismatch --skip UnorderedKey .env.example app/api/.env.example app/dashboard/.env.example app/marketing/.env.example",
    "lint:shell": "git ls-files '*.sh' | xargs -r shellcheck -x --rcfile .shellcheckrc",
    "lint:secrets": "gitleaks git --no-banner --config .gitleaks.toml",
    "lint:deps": "syncpack lint --config syncpack.config.js",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip --no-progress"
  },
  "type": "module",
  "devDependencies": {
    "@abugida/bun-test-config": "workspace:*",
    "@abugida/prettier-config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "cspell": "^10.3.3",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.2.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.4"
  }
}
