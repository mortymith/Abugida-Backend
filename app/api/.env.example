# -----------------------------------------------------------------------------
# Abugida API — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# All variables without defaults are REQUIRED for the server to start.
# Secrets are never printed by the app or included in validation errors.
# -----------------------------------------------------------------------------

# ── App ──────────────────────────────────────────────────────────────────────
# One of: development | staging | production | test. `ENVIRONMENT` wins when
# both it and `NODE_ENV` are set.
ENVIRONMENT=development
# NODE_ENV=development
PORT=3000
# HOST=0.0.0.0
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL via PgBouncer (transaction-mode connection pooler).
# REQUIRED. Must be a postgres:// or postgresql:// URL.
DATABASE_URL=postgresql://app:change-me@pgbouncer:6432/app
# Max pg Pool size (PgBouncer default pool size is 20).
# DATABASE_POOL_MAX=20

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used by Better Auth for session & CSRF token signing (min 32 chars).
# REQUIRED. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL where the auth endpoints are reachable.
# REQUIRED. Must use https in production.
BETTER_AUTH_URL=http://localhost:3000

# Base URL used for JWT issuer claims (typically equals BETTER_AUTH_URL).
# AUTH_BASE_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin of the frontend app that calls this API (used for CORS and CSRF).
# WEB_APP_URL=http://localhost:5173

# Additional CORS origins, comma-separated (e.g. native WebViews).
# Merged with WEB_APP_URL into the resolved allowlist. Production origins
# must use https (per spec: https://app.abugada.com, capacitor://localhost,
# ionic://localhost).
# CORS_ORIGINS=capacitor://localhost,ionic://localhost

# ── Tokens (optional) ────────────────────────────────────────────────────────
# Custom JWT audience claim — enable if you issue tokens for PowerSync or
# other third-party consumers. Requires better-auth's generated `jwks` table
# in the Drizzle schema.
# TOKEN_AUDIENCE=abugida

# ── OAuth — Google (at least one provider required) ─────────────────────────
# Enable Google sign-in by providing OAuth 2.0 credentials from Google Cloud.
# At least one of Google or Apple MUST be configured for the API to start.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── OAuth — Apple (at least one provider required) ──────────────────────────
# Enable "Sign in with Apple" by providing App Store Connect credentials.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ── Queue (BullMQ / Redis) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# ACL username (Redis 6+). The Abugida infra runs `user default off` and
# exposes an `app` ACL user — use REDIS_USERNAME=app with the dev password.
# REDIS_USERNAME=app
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false

# ── Rate limiting (API spec NFR-403) ────────────────────────────────────────
# Window shared by every limiter (seconds).
# RATE_LIMIT_WINDOW_SECONDS=60
# Authenticated users: 100 requests per minute.
# RATE_LIMIT_AUTHENTICATED_PER_MINUTE=100
# Unauthenticated IPs: 1000 requests per minute.
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=1000
# Better Auth per-IP/per-route limiter on /auth endpoints.
# AUTH_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── Observability (Pino + OpenTelemetry) ────────────────────────────────────
# OTEL_SERVICE_NAME=api
# OTEL_SERVICE_VERSION=0.0.1
# OTEL_DEPLOYMENT_ENVIRONMENT=development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1

# ── Storage (S3-compatible) — optional ──────────────────────────────────────
# Leave unset to run without object storage. When set, the credential trio
# below is required.
# One of: aws-s3, minio, r2, spaces, wasabi, b2
# STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin
# STORAGE_BUCKET=abugida
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_MAX_ATTEMPTS=3
# STORAGE_REQUEST_TIMEOUT=30000
# STORAGE_CONNECTION_TIMEOUT=5000
