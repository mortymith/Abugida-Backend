{
  "name": "@abugida/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@abugida/auth": "workspace:*",
    "@abugida/database": "workspace:*",
    "@abugida/observability": "workspace:*",
    "@abugida/queue": "workspace:*",
    "@abugida/storage": "workspace:*",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.11",
    "better-auth": "1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "^11.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "8.21.0",
    "dotenv-expand": "^13.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
