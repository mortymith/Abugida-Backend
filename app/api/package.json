{
  "name": "@abugida/api",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "predev": "pnpm --filter \"@abugida/api^...\" run build",
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "typecheck": "bun check",
    "test": "bun test --pass-with-no-tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@abugida/auth": "workspace:*",
    "@abugida/database": "workspace:*",
    "@abugida/observability": "workspace:*",
    "@abugida/queue": "workspace:*",
    "@abugida/storage": "workspace:*",
    "@abugida/tenant": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.13",
    "better-auth": "1.6.26",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "rate-limiter-flexible": "^11.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@abugida/eslint-config": "workspace:*",
    "@abugida/prettier-config": "workspace:*",
    "@abugida/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  }
}
