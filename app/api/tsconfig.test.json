{
  "extends": "@abugida/typescript-config/node.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    // Same alias contract as tsconfig.json: `#/` maps to the app root.
    "paths": { "#/*": ["./*"] },
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "modules/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
