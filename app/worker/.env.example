# -----------------------------------------------------------------------------
# Abugida Worker — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# All variables without defaults are REQUIRED for the worker to start.
# Secrets are never printed by the app or included in validation errors.
# -----------------------------------------------------------------------------

# ── App ──────────────────────────────────────────────────────────────────────
# One of: development | staging | production | test. `ENVIRONMENT` wins when
# both it and `NODE_ENV` are set.
ENVIRONMENT=development
# NODE_ENV=development
# Port of the health endpoint (liveness + readiness). Local development uses
# 3003; the container image pins 3000 (see docker/compose/app.yml).
PORT=3003
LOG_LEVEL=info
# Used to build the worker id (`<APP_NAME>-worker-<pid>`).
APP_NAME=abugida-worker

# ── Queue selection ──────────────────────────────────────────────────────────
# `all` consumes every declared queue; a CSV of full queue names restricts the
# worker to those queues (e.g. `abugida.purchases,abugida.webhooks`). The
# per-queue rollout is gated through this setting.
WORKER_QUEUES=all

# ── Redis (BullMQ queues live on Redis / Redis Sentinel) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# ACL username (Redis 6+). The Abugida infra runs `user default off` and
# exposes an `app` ACL user — use REDIS_USERNAME=app with the dev password.
# REDIS_USERNAME=app
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ── Telebirr (payment gateway) ──────────────────────────────────────────────
# Only needed by the PURCHASE_* processors. Every value is optional: a worker
# that never touches Telebirr starts without them.
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_MERCHANT_APP_ID=
# TELEBIRR_MERCHANT_CODE=
# PEM key used for signing requests (inline or a file path).
# TELEBIRR_PRIVATE_KEY=
# TELEBIRR_PRIVATE_KEY_PATH=
# Platform public key used to verify responses and callbacks.
# TELEBIRR_PUBLIC_KEY=
# TELEBIRR_PUBLIC_KEY_PATH=
# TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
# TELEBIRR_NOTIFY_URL=
# TELEBIRR_REDIRECT_URL=
# TELEBIRR_CHECKOUT_BASE_URL=
# TELEBIRR_TRADE_TYPE=Checkout
# TELEBIRR_CURRENCY=ETB
# TELEBIRR_TIMEOUT_EXPRESS=120m
# TELEBIRR_SIGNATURE_PADDING=pss
# TELEBIRR_TIMEOUT_MS=30000

# ── SMSEthiopia (SMS provider) ──────────────────────────────────────────────
# Only needed by the SMS_NOTIFICATION processor. Optional.
# SMS_ETHIOPIA_API_KEY=
# SMS_ETHIOPIA_BASE_URL=https://smsethiopia.com
# SMS_ETHIOPIA_API_VERSION=v2
# SMS_ETHIOPIA_MESSAGE_TYPE=
# SMS_ETHIOPIA_TIMEOUT_MS=30000

# ── Observability (Pino + OpenTelemetry) ────────────────────────────────────
# OTEL_SERVICE_NAME=worker
# OTEL_SERVICE_VERSION=0.0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1
