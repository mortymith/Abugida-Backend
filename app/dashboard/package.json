{
  "name": "@abugida/dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run vite dev --port 3000",
    "generate-routes": "bun run tsr generate",
    "build": "bun run vite build",
    "preview": "bun run vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "bun run tsc --noEmit",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "bun run drizzle-kit migrate",
    "db:push": "bun run drizzle-kit push",
    "db:pull": "bun run drizzle-kit pull",
    "db:studio": "bun run drizzle-kit studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/ai": "0.43.1",
    "@tanstack/ai-anthropic": "0.16.4",
    "@tanstack/ai-client": "0.23.1",
    "@tanstack/ai-gemini": "0.21.0",
    "@tanstack/ai-ollama": "0.8.17",
    "@tanstack/ai-openai": "0.18.0",
    "@tanstack/ai-react": "0.19.1",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.42",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/store": "0.11.1",
    "better-auth": "1.6.25",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "highlight.js": "11.11.1",
    "lucide-react": "0.577.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "2.5.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.26",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "17.4.2",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
