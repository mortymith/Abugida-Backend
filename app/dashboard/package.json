  "devDependencies": {
    "@abugida/eslint-config": "workspace:*",
    "@abugida/prettier-config": "workspace:*",
    "@abugida/typescript-config": "workspace:*",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.45",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  }
