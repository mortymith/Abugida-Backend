{
  "name": "@abugida/dashboard",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "predev": "pnpm --filter \"@abugida/dashboard^...\" run build",
    "dev": "bun run vite dev --port 3000",
    "generate-routes": "bun run tsr generate",
    "build": "bun run vite build",
    "preview": "bun run vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "bun run tsc --noEmit",
    "migrate:lesson-markdown": "bun run scripts/migrate-lesson-markdown.ts",
    "probe:tenant": "bun run scripts/dashboard.tenant-probe.ts",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@abugida/auth": "workspace:*",
    "@abugida/database": "workspace:*",
    "@abugida/observability": "workspace:*",
    "@abugida/queue": "workspace:*",
    "@abugida/storage": "workspace:*",
    "@abugida/tenant": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-ethiopic": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-anthropic": "1.0.0",
    "@tanstack/ai-gemini": "1.0.0",
    "@tanstack/ai-openai": "1.0.0",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-charts": "^1.1.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "lucide-react": "1.61.0",
    "mammoth": "1.13.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
