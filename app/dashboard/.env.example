# -----------------------------------------------------------------------------
# Abugida Dashboard — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# All variables without defaults are REQUIRED for the server to start.
# -----------------------------------------------------------------------------

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=Abugida Academy

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL via PgBouncer (transaction-mode connection pooler)
DATABASE_URL=postgresql://app:change-me@pgbouncer:6432/app

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used by Better Auth for session & CSRF token signing (min 32 chars).
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL where the auth endpoints are reachable.
BETTER_AUTH_URL=http://localhost:3000

# Base URL used for JWT issuer claims (typically equals BETTER_AUTH_URL).
AUTH_BASE_URL=http://localhost:3000

# Base path for auth API endpoints.
AUTH_BASE_PATH=/auth

# Client-side auth endpoint path. The browser calls the dashboard's own origin.
VITE_AUTH_BASE_PATH=/auth

# Path to redirect unauthenticated users to.
LOGIN_PATH=/login
VITE_LOGIN_PATH=/login

# Default redirect path after successful login.
DEFAULT_LOGIN_REDIRECT=/dashboard
VITE_DEFAULT_LOGIN_REDIRECT=/dashboard

# ── Auth Callbacks ───────────────────────────────────────────────────────────
# Backend-owned OAuth redirect destinations. If unset, BETTER_AUTH_URL is used.
# AUTH_CALLBACK_URL=http://localhost:3000
# AUTH_ERROR_CALLBACK_URL=http://localhost:3000
# AUTH_NEW_USER_CALLBACK_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin of the frontend app that calls this API (used for CORS and CSRF).
# WEB_APP_URL=http://localhost:3000

# ── Tokens (optional) ────────────────────────────────────────────────────────
# Custom JWT audience claim — enable if you issue tokens for PowerSync or
# other third-party consumers.
# TOKEN_AUDIENCE=abugida

# ── Branding ─────────────────────────────────────────────────────────────────
# App name displayed in UI (title, sidebar, login page).
VITE_APP_NAME=Abugida Academy

# Domain suffix for workspace URLs (e.g. {slug}.abugida.app).
WORKSPACE_DOMAIN=abugida.app
VITE_WORKSPACE_DOMAIN=abugida.app

# ── Two-Factor Authentication ────────────────────────────────────────────────
# TOTP issuer name shown in authenticator apps.
TOTP_ISSUER=Abugida Academy

# Max age of the 2FA cookie in seconds (default: 600 = 10 minutes).
TWO_FACTOR_COOKIE_MAX_AGE=600

# How long a trusted device is remembered in seconds (default: 2592000 = 30 days).
TRUST_DEVICE_MAX_AGE=2592000

# ── Account Lockout ──────────────────────────────────────────────────────────
# Max failed login attempts before lockout (default: 5).
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5

# Lockout duration in seconds (default: 600 = 10 minutes).
ACCOUNT_LOCKOUT_DURATION=600

# ── MFA ──────────────────────────────────────────────────────────────────────
# Max MFA verification attempts on the client before lockout (default: 5).
MFA_MAX_ATTEMPTS=5
VITE_MFA_MAX_ATTEMPTS=5

# ── Queue (BullMQ / Redis) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── Storage (S3-compatible) ──────────────────────────────────────────────────
# One of: aws-s3, minio, r2, spaces, wasabi, b2
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=abugida
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_MAX_ATTEMPTS=3
# STORAGE_REQUEST_TIMEOUT=30000
# STORAGE_CONNECTION_TIMEOUT=5000

# ── OAuth — Google (optional) ────────────────────────────────────────────────
# Enable Google sign-in by providing OAuth 2.0 credentials from Google Cloud.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── OAuth — Telegram (optional) ──────────────────────────────────────────────
# Telegram sign-in runs exclusively through Telegram OpenID Connect
# (oauth.telegram.org). Get both from @BotFather > Bot Settings > Web Login
# (OpenID Connect) and set them together. The client secret is NOT the bot
# token.
# TELEGRAM_OIDC_CLIENT_ID=
# TELEGRAM_OIDC_CLIENT_SECRET=

# ── AI generation (spec 04 S-2.11 / S-2.16) ─────────────────────────────
# Optional: with none set, the dashboard uses a deterministic local
# generator so the review-and-accept workflow still works end to end.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ── Observability (Pino + OpenTelemetry) ───────────────────────────────
OTEL_SERVICE_NAME=dashboard
OTEL_SERVICE_VERSION=0.0.1
# OTEL_DEPLOYMENT_ENVIRONMENT=development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1
LOG_LEVEL=info
