{
  "extends": "@abugida/typescript-config/base.json",
  "include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "vite.config.ts"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Known relaxations vs the shared base (see tooling/typescript-config) */
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    /* This app never emits: no declarations, no declaration maps. */
    "declaration": false,
    "declarationMap": false
  }
}
