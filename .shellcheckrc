# Repository-level ShellCheck configuration for the Abugida monorepo.
# Owned by the repository root: shellcheck discovers .shellcheckrc in the
# working directory, and the root script passes it explicitly
# (shellcheck -x --rcfile .shellcheckrc).

# Ops scripts source shared libraries and rely on dynamic paths; follow
# `source` directives when the file is resolvable.
disable=SC1091

# Scripts intentionally target bash on Linux (dev containers, CI, prod images).
# EC2/ECS-style init snippets are not a concern here.
disable=SC2034

# run_probe / audit / validate-secrets dispatch probe functions by reference
# (function names passed as arguments), so shellcheck cannot see the call
# sites and reports every probe body as unreachable.
disable=SC2317
